                                            <StackPanel Spacing="6">
                                                <Border Width="150" Height="150" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind CoverImgUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" MaxLines="2" Height="36" TextWrapping="Wrap" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
