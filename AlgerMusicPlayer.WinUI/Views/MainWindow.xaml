                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Image Source="{x:Bind CoverUrl}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
