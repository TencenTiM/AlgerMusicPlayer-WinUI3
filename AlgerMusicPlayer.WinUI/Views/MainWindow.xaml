                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBox x:Name="RemoteAllowedIpsBox" PlaceholderText="多个 IP 用逗号分隔，留空允许所有 IP" />
                                            <TextBlock Text="空列表表示允许所有IP访问" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="保存" Click="OnApplyRemotePortClick" Style="{StaticResource BrandPrimaryButtonStyle}" CornerRadius="8" Padding="18,6" />
                                        <Button Content="重置" Click="OnResetRemoteControlClick" CornerRadius="8" Padding="18,6" />
                                    </StackPanel>
                                    <Border Background="#140EA5E9" BorderBrush="#400EA5E9" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="远程控制访问地址:" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock x:Name="RemoteControlUrlText" Text="http://localhost:31888/" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource BrandAccentBrush}" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ==================== 模态弹窗 5：代理设置 (1:1 还原 ProxySettings.vue) ==================== -->
                        <Grid x:Name="ProxySettingsModalOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000" Margin="-28,-24,-28,-24" Canvas.ZIndex="60">
                            <Border
                                Width="460"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="22,18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <TextBlock Text="代理设置" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right" Click="OnCloseProxyModalClick" Style="{StaticResource TransportIconButtonStyle}">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="代理设置" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ProxyProtocolComboBox" Grid.Column="1" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="HTTP" Tag="http" IsSelected="True" />
                                            <ComboBoxItem Content="HTTPS" Tag="https" />
                                            <ComboBoxItem Content="SOCKS5" Tag="socks5" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="代理地址" VerticalAlignment="Center" />
                                        <TextBox x:Name="ProxyHostBox" Grid.Column="1" PlaceholderText="请输入代理地址" Text="127.0.0.1" />
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="代理端口" VerticalAlignment="Center" />
                                        <TextBox x:Name="ProxyPortBox" Grid.Column="1" PlaceholderText="请输入代理端口" Text="7890" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Content="取消" Click="OnCloseProxyModalClick" CornerRadius="8" Padding="16,6" />
                                        <Button Content="确认" Click="OnConfirmProxyModalClick" Style="{StaticResource BrandPrimaryButtonStyle}" CornerRadius="8" Padding="16,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ==================== 模态弹窗 6：缓存管理 (1:1 还原 ClearCacheSettings.vue) ==================== -->
                        <Grid x:Name="ClearCacheModalOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#88000000" Margin="-28,-24,-28,-24" Canvas.ZIndex="60">
                            <Border
                                Width="480"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="22,18">
                                <StackPanel Spacing="14">
                                    <Grid>
                                        <TextBlock Text="缓存管理" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right" Click="OnCloseClearCacheModalClick" Style="{StaticResource TransportIconButtonStyle}">
                                            <FontIcon Glyph="&#xE711;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="请选择要清除的缓存类型：" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Spacing="10">
                                        <CheckBox x:Name="ClearHistoryCheck" Tag="history">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="播放历史" FontSize="14" />
                                                <TextBlock Text="清除播放过的歌曲记录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ClearFavoriteCheck" Tag="favorite">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="收藏记录" FontSize="14" />
                                                <TextBlock Text="清除本地收藏的歌曲记录(不会影响云端收藏)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ClearUserCheck" Tag="user">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="用户数据" FontSize="14" />
                                                <TextBlock Text="清除登录信息和用户相关数据" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ClearSettingsCheck" Tag="settings">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="应用设置" FontSize="14" />
                                                <TextBlock Text="清除应用的所有自定义设置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ClearDownloadsCheck" Tag="downloads">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="下载记录" FontSize="14" />
                                                <TextBlock Text="清除下载历史记录(不会删除已下载的文件)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ClearResourcesCheck" Tag="resources">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="音乐资源" FontSize="14" />
                                                <TextBlock Text="清除已加载的音乐文件、歌词等资源缓存" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ClearLyricsCheck" Tag="lyrics">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="歌词资源" FontSize="14" />
                                                <TextBlock Text="清除已加载的歌词资源缓存" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Content="取消" Click="OnCloseClearCacheModalClick" CornerRadius="8" Padding="16,6" />
                                        <Button Content="确认" Click="OnClearSelectedAppDataClick" Style="{StaticResource BrandPrimaryButtonStyle}" CornerRadius="8" Padding="16,6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>

        <!-- ==================== 2.5 右侧全局抽屉：当前播放队列 (对应 PlayingListDrawer.vue，ZIndex 高于播放详情页，点击外部任意区域自动收起) ==================== -->
        <Grid
            x:Name="QueueDrawerOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            Canvas.ZIndex="80"
            Visibility="Collapsed">
            <!-- 全屏半透明遮罩层（点击抽屉外任意区域收起播放队列） -->
            <Border
                x:Name="QueueDrawerBackdrop"
                Background="#22000000"
                Tapped="OnQueueDrawerBackdropTapped" />

            <!-- 右侧播放列表抽屉面板（1:1 还原 PlayingListDrawer.vue + MiniSongItem.vue + 左侧拖拽手柄） -->
            <Border
                x:Name="QueueDrawerPanel"
                Width="350"
                Height="540"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CornerRadius="12,0,0,12"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,1"
                Translation="0,0,28">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- playlist-panel-header -->
                    <Grid
                        Grid.Row="0"
                        Padding="16,0,12,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="播放列表"
                            FontSize="14"
                            FontWeight="Medium"
                            VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnClearQueueClick"
                                ToolTipService.ToolTip="清空播放列表">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnToggleQueueDrawerClick"
                                ToolTipService.ToolTip="关闭">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- playlist-panel-content (MiniSongItem + 左侧拖拽手柄) -->
                    <ListView
                        x:Name="QueueListView"
                        Grid.Row="1"
                        Padding="6,6,6,12"
                        SelectionMode="None"
                        CanReorderItems="True"
                        AllowDrop="True"
                        IsItemClickEnabled="True"
                        ItemClick="OnQueueItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="MinHeight" Value="54" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SongItem">
                                <Grid ColumnSpacing="10" Padding="4,4">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="下一首播放" Tag="{x:Bind}" Click="OnQueueContextPlayNextClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE893;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="从播放列表移除" Tag="{x:Bind}" Click="OnQueueContextRemoveClick">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧可拖动调整顺序手柄 -->
                                    <FontIcon
                                        Grid.Column="0"
                                        Glyph="&#xE76F;"
                                        FontSize="12"
                                        Opacity="0.4"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="拖动调整顺序" />

                                    <!-- 40x40 圆角封面 (song-item-img) -->
                                    <Border
                                        Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="10"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind CoverThumbnailUrl}" Stretch="UniformToFill" />
                                    </Border>

                                    <!-- 歌曲标题与歌手 (song-item-content) -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <Grid>
                                            <TextBlock
                                                Text="{x:Bind Name}"
                                                FontSize="14"
                                                Foreground="#22C55E"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}" />
                                            <TextBlock
                                                FontSize="14"
                                                MaxLines="1"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{x:Bind NotPlayingVisibility, Mode=OneWay}">
                                                <Run Text="{x:Bind Name}" />
                                                <Run Text="{x:Bind BracketSubtitleText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock
                                            Text="{x:Bind ArtistText}"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 右侧胶囊操作区 (song-item-operating: [ ♥ (▶) ]) -->
                                    <Border
                                        Grid.Column="3"
                                        Height="34"
                                        Padding="6,0,0,0"
                                        CornerRadius="17"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                            <!-- 喜欢按钮 (song-item-operating-like) -->
                                            <Button
                                                Tag="{x:Bind}"
                                                Click="OnSongLikeButtonClick"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                CornerRadius="14"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="喜欢">
                                                <Grid>
                                                    <FontIcon
                                                        Glyph="&#xEB52;"
                                                        FontSize="13"
                                                        Foreground="#EF4444"
                                                        Visibility="{x:Bind LikedVisibility, Mode=OneWay}" />
                                                    <FontIcon
                                                        Glyph="&#xEB52;"
                                                        FontSize="13"
                                                        Foreground="#6B7280"
                                                        Visibility="{x:Bind NotLikedVisibility, Mode=OneWay}" />
                                                </Grid>
                                            </Button>

                                            <!-- 播放/暂停圆形按钮 (song-item-operating-play) -->
                                            <Button
                                                Tag="{x:Bind}"
                                                Click="OnQueuePlayButtonClick"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                CornerRadius="16"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="播放/暂停">
                                                <Grid Width="32" Height="32">
                                                    <Border
                                                        Width="32"
                                                        Height="32"
                                                        CornerRadius="16"
                                                        Background="#22C55E"
                                                        Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}">
                                                        <FontIcon
                                                            Glyph="{x:Bind ActivePlayGlyph, Mode=OneWay}"
                                                            FontSize="11"
                                                            Foreground="White"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border
                                                        Width="32"
                                                        Height="32"
                                                        CornerRadius="16"
                                                        Background="#2864748B"
                                                        Visibility="{x:Bind NotPlayingVisibility, Mode=OneWay}">
                                                        <FontIcon
                                                            Glyph="&#xE768;"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 2.8 添加到歌单抽屉 (1:1 还原 PlaylistDrawer.vue) ==================== -->
        <Grid
            x:Name="AddToPlaylistDrawerOverlay"
            Grid.Row="1"
            Canvas.ZIndex="28"
            Visibility="Collapsed">
            <Border
                x:Name="AddToPlaylistBackdrop"
                Background="#22000000"
                Tapped="OnAddToPlaylistBackdropTapped" />

            <Border
                x:Name="AddToPlaylistDrawerPanel"
                Width="400"
                HorizontalAlignment="Right"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Padding="20,16">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 抽屉顶部标题 -->
                    <Grid Grid.Row="0" Padding="0,0,0,10" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="AddToPlaylistDrawerTitleText" Text="添加到歌单" FontSize="17" FontWeight="Bold" />
                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            CornerRadius="14"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCloseAddToPlaylistDrawerClick">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 创建新歌单入口与展开表单 -->
                    <StackPanel Grid.Row="1" Spacing="12">
                        <Button
                            Click="OnToggleCreatePlaylistFormClick"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12"
                            CornerRadius="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Border Width="42" Height="42" CornerRadius="12" Background="#10B981">
                                    <FontIcon x:Name="CreatePlaylistToggleIcon" Glyph="&#xE710;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="CreatePlaylistToggleText" Text="创建新歌单" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border
                            x:Name="CreatePlaylistFormPanel"
                            Visibility="Collapsed"
                            Padding="14,12"
                            CornerRadius="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBox
                                    x:Name="NewPlaylistNameInput"
                                    PlaceholderText="输入歌单名称..."
                                    MaxLength="40"
                                    CornerRadius="16" />
                                <Grid x:Name="NewPlaylistPrivacyRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE72E;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="设置为隐私歌单" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NewPlaylistPrivateSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" />
                                </Grid>
                                <Button
                                    Content="创建歌单"
                                    Click="OnConfirmCreatePlaylistClick"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource BrandPrimaryButtonStyle}"
                                    CornerRadius="18"
                                    Padding="0,8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 用户创建的歌单列表 -->
                    <ListView
                        x:Name="AddToPlaylistTargetListView"
                        Grid.Row="2"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnAddToTargetPlaylistItemClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlaylistItem">
                                <Grid Padding="8,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind CoverImgUrl}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TrackCountBadgeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16" Background="#1510B981" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. 播放详情页 (1:1 还原 MusicFull.vue + Cover3D + SimplePlayBar + LyricSettings + LyricCorrectionControl，覆盖整个客户端窗口含标题栏) ==================== -->
        <Grid
            x:Name="ImmersiveLyricOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Canvas.ZIndex="40"
            RequestedTheme="Dark"
            Visibility="Collapsed"
            PointerMoved="OnImmersiveOverlayPointerMoved"
            PointerExited="OnImmersiveOverlayPointerExited">
            <Grid.Background>
                <LinearGradientBrush x:Name="MusicFullBgGradientBrush" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="MusicFullBgStop0" Color="#FF1E293B" Offset="0.0" />
                    <GradientStop x:Name="MusicFullBgStop1" Color="#FF0F172A" Offset="0.5" />
                    <GradientStop x:Name="MusicFullBgStop2" Color="#FF050811" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- 顶部窗口拖拽条（播放详情展开时支持在顶部拖拽移动窗口） -->
            <Border
                x:Name="ImmersiveTitleDragBar"
                VerticalAlignment="Top"
                Height="32"
                Margin="0,0,148,0"
                Background="Transparent"
                Canvas.ZIndex="45" />

            <!-- 背景图片层（对应 MusicFull.vue .background-layer：仅在自定义图片背景模式下显示，支持模糊与明暗度调节） -->
            <Grid x:Name="MusicFullCustomBgImageLayer" Visibility="Collapsed" IsHitTestVisible="False">
                <Image x:Name="MusicFullCustomBgImage" Stretch="UniformToFill" />
                <Border x:Name="MusicFullCustomBgDimBorder" Background="#40000000" />
            </Grid>

            <!-- 左上角：收起播放详情页按钮 (对应 MusicFull.vue .control-left) -->
            <StackPanel
                x:Name="MusicFullLeftControlPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="32,38,0,0"
                Canvas.ZIndex="50">
                <Button
                    x:Name="MusicFullCloseBtn"
                    Width="36"
                    Height="36"
                    Padding="0"
                    CornerRadius="8"
                    Background="#318E8E8E"
                    BorderThickness="0"
                    Click="OnToggleImmersiveLyricClick"
                    ToolTipService.ToolTip="收起播放详情页">
                    <FontIcon x:Name="MusicFullCloseIcon" Glyph="&#xE70D;" FontSize="15" Foreground="White" />
                </Button>
            </StackPanel>

            <!-- 右上角：歌词设置浮层按钮 + 全屏切换按钮 (对应 MusicFull.vue .control-right) -->
            <StackPanel
                x:Name="MusicFullRightControlPanel"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,38,32,0"
                Canvas.ZIndex="50">
                <!-- 歌词设置 Popover 按钮 (1:1 对应 LyricSettings.vue) -->
                <Button
                    x:Name="MusicFullSettingsBtn"
                    Width="36"
                    Height="36"
                    Padding="0"
                    CornerRadius="8"
                    Background="#318E8E8E"
                    BorderThickness="0"
                    ToolTipService.ToolTip="歌词设置">
                    <FontIcon x:Name="MusicFullSettingsIcon" Glyph="&#xE713;" FontSize="15" Foreground="White" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Border
                                Width="328"
                                RequestedTheme="Dark"
                                CornerRadius="14"
                                Background="#EB14181F"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Padding="16,14">
                                <StackPanel Spacing="12">
                                    <!-- 标题栏 -->
                                    <Border Padding="0,0,0,8" BorderBrush="#18FFFFFF" BorderThickness="0,0,0,1">
                                        <TextBlock Text="歌词设置" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                    </Border>

                                    <!-- 4 标签页导航：显示 | 界面 | 文字 | 背景 -->
                                    <Border Background="#40000000" CornerRadius="10" Padding="4">
                                        <Grid ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="LyricSetTabDisplayBtn"
                                                Grid.Column="0"
                                                Content="显示"
                                                Tag="display"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8"
                                                Padding="0,6"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="OnLyricSettingsTabClick" />
                                            <Button
                                                x:Name="LyricSetTabInterfaceBtn"
                                                Grid.Column="1"
                                                Content="界面"
                                                Tag="interface"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8"
                                                Padding="0,6"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="OnLyricSettingsTabClick" />
                                            <Button
                                                x:Name="LyricSetTabTypographyBtn"
                                                Grid.Column="2"
                                                Content="文字"
                                                Tag="typography"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8"
                                                Padding="0,6"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="OnLyricSettingsTabClick" />
                                            <Button
                                                x:Name="LyricSetTabBackgroundBtn"
                                                Grid.Column="3"
                                                Content="背景"
                                                Tag="background"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="8"
                                                Padding="0,6"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Click="OnLyricSettingsTabClick" />
                                        </Grid>
                                    </Border>

                                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                        <Grid Padding="0,2,2,4">
                                            <!-- Tab 1：显示设置 (display) -->
                                            <StackPanel x:Name="LyricSetDisplayPanel" Visibility="Visible" Spacing="8">
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                                    <Grid>
                                                        <TextBlock Text="纯净模式" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Name="LyricPureModeToggle" OffContent="" OnContent="" MinWidth="44" HorizontalAlignment="Right" Toggled="OnLyricDisplayConfigToggled" />
                                                    </Grid>
                                                </Border>
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                                    <Grid>
                                                        <TextBlock Text="隐藏封面" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Name="LyricHideCoverToggle" OffContent="" OnContent="" MinWidth="44" HorizontalAlignment="Right" Toggled="OnLyricDisplayConfigToggled" />
                                                    </Grid>
                                                </Border>
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                                    <Grid>
                                                        <TextBlock Text="居中显示" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Name="LyricCenterToggle" OffContent="" OnContent="" MinWidth="44" HorizontalAlignment="Right" Toggled="OnLyricDisplayConfigToggled" />
                                                    </Grid>
                                                </Border>
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                                    <Grid>
                                                        <TextBlock Text="显示翻译" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Name="LyricShowTransToggle" IsOn="True" OffContent="" OnContent="" MinWidth="44" HorizontalAlignment="Right" Toggled="OnLyricDisplayConfigToggled" />
                                                    </Grid>
                                                </Border>
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                                    <Grid>
                                                        <TextBlock Text="隐藏歌词" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Name="LyricHideLyricsToggle" OffContent="" OnContent="" MinWidth="44" HorizontalAlignment="Right" Toggled="OnLyricDisplayConfigToggled" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Tab 2：界面设置 (interface) -->
                                            <StackPanel x:Name="LyricSetInterfacePanel" Visibility="Collapsed" Spacing="10">
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                                    <Grid>
                                                        <TextBlock Text="显示迷你播放栏" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Name="LyricShowMiniPlayBarToggle" IsOn="True" OffContent="" OnContent="" MinWidth="44" HorizontalAlignment="Right" Toggled="OnLyricDisplayConfigToggled" />
                                                    </Grid>
                                                </Border>

                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                    <StackPanel Spacing="6">
                                                        <Grid>
                                                            <TextBlock Text="内容区宽度" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <TextBlock x:Name="LyricContentWidthValueText" Text="75%" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="LyricContentWidthSlider"
                                                            Minimum="50"
                                                            Maximum="100"
                                                            StepFrequency="5"
                                                            Value="75"
                                                            ValueChanged="OnLyricTypographySliderChanged" />
                                                        <Grid>
                                                            <TextBlock Text="50%" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Left" />
                                                            <TextBlock Text="75%" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                                            <TextBlock Text="100%" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Tab 3：文字设置 (typography) -->
                                            <StackPanel x:Name="LyricSetTypographyPanel" Visibility="Collapsed" Spacing="10">
                                                <!-- 字体大小 -->
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <TextBlock Text="字体大小" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <TextBlock x:Name="LyricFontSizeValueText" Text="22px" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="LyricFontSizeSlider"
                                                            Minimum="12"
                                                            Maximum="32"
                                                            StepFrequency="1"
                                                            Value="22"
                                                            ValueChanged="OnLyricTypographySliderChanged" />
                                                        <Grid>
                                                            <TextBlock Text="小" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Left" />
                                                            <TextBlock Text="中" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                                            <TextBlock Text="大" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 字间距 -->
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <TextBlock Text="字间距" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <TextBlock x:Name="LyricLetterSpacingValueText" Text="0px" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="LyricLetterSpacingSlider"
                                                            Minimum="-2"
                                                            Maximum="10"
                                                            StepFrequency="0.5"
                                                            Value="0"
                                                            ValueChanged="OnLyricTypographySliderChanged" />
                                                        <Grid>
                                                            <TextBlock Text="紧凑" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Left" />
                                                            <TextBlock Text="默认" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                                            <TextBlock Text="宽松" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 字体粗细 -->
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <TextBlock Text="字体粗细" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <TextBlock x:Name="LyricFontWeightValueText" Text="500" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="LyricFontWeightSlider"
                                                            Minimum="100"
                                                            Maximum="900"
                                                            StepFrequency="100"
                                                            Value="500"
                                                            ValueChanged="OnLyricTypographySliderChanged" />
                                                        <Grid>
                                                            <TextBlock Text="细" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Left" />
                                                            <TextBlock Text="常规" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                                            <TextBlock Text="粗" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 行高 -->
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <TextBlock Text="行高" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <TextBlock x:Name="LyricLineHeightValueText" Text="2.0" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <Slider
                                                            x:Name="LyricLineHeightSlider"
                                                            Minimum="1.0"
                                                            Maximum="3.0"
                                                            StepFrequency="0.1"
                                                            Value="2.0"
                                                            ValueChanged="OnLyricTypographySliderChanged" />
                                                        <Grid>
                                                            <TextBlock Text="紧凑" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Left" />
                                                            <TextBlock Text="默认" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                                            <TextBlock Text="宽松" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Tab 4：背景设置 (background) -->
                                            <StackPanel x:Name="LyricSetBackgroundPanel" Visibility="Collapsed" Spacing="10">
                                                <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8">
                                                    <Grid>
                                                        <TextBlock Text="使用自定义背景" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                                                        <ToggleSwitch x:Name="LyricUseCustomBgToggle" OffContent="" OnContent="" MinWidth="44" HorizontalAlignment="Right" Toggled="OnLyricDisplayConfigToggled" />
                                                    </Grid>
                                                </Border>

                                                <!-- 未启用自定义背景时：背景主题（默认封面取色 / 亮色 / 暗色） -->
                                                <Border x:Name="LyricBgThemeGroup" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="背景主题" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button x:Name="LyricThemeDefaultBtn" Grid.Column="0" Content="默认" Tag="default" HorizontalAlignment="Stretch" Click="OnLyricThemeOptionClick" FontSize="12" />
                                                            <Button x:Name="LyricThemeLightBtn" Grid.Column="1" Content="亮色" Tag="light" HorizontalAlignment="Stretch" Click="OnLyricThemeOptionClick" FontSize="12" />
                                                            <Button x:Name="LyricThemeDarkBtn" Grid.Column="2" Content="暗色" Tag="dark" HorizontalAlignment="Stretch" Click="OnLyricThemeOptionClick" FontSize="12" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- 启用自定义背景时：纯色 / 渐变 / 图片 / CSS 四种模式 -->
                                                <StackPanel x:Name="LyricBgCustomGroup" Visibility="Collapsed" Spacing="10">
                                                    <Border Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="背景模式" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <Grid ColumnSpacing="6" RowSpacing="6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Button x:Name="LyricBgModeSolidBtn" Grid.Row="0" Grid.Column="0" Content="纯色" Tag="solid" HorizontalAlignment="Stretch" Click="OnLyricBgModeOptionClick" FontSize="12" />
                                                                <Button x:Name="LyricBgModeGradientBtn" Grid.Row="0" Grid.Column="1" Content="渐变" Tag="gradient" HorizontalAlignment="Stretch" Click="OnLyricBgModeOptionClick" FontSize="12" />
                                                                <Button x:Name="LyricBgModeImageBtn" Grid.Row="1" Grid.Column="0" Content="图片" Tag="image" HorizontalAlignment="Stretch" Click="OnLyricBgModeOptionClick" FontSize="12" />
                                                                <Button x:Name="LyricBgModeCssBtn" Grid.Row="1" Grid.Column="1" Content="CSS" Tag="css" HorizontalAlignment="Stretch" Click="OnLyricBgModeOptionClick" FontSize="12" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 模式 1：纯色 -->
                                                    <Border x:Name="LyricBgModeSolidPanel" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="选择颜色" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#1A1A1A" Tag="#1A1A1A" Click="OnLyricSolidPresetClick" />
                                                                <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#0F172A" Tag="#0F172A" Click="OnLyricSolidPresetClick" />
                                                                <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#064E3B" Tag="#064E3B" Click="OnLyricSolidPresetClick" />
                                                                <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#1E1B4B" Tag="#1E1B4B" Click="OnLyricSolidPresetClick" />
                                                                <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#3B0764" Tag="#3B0764" Click="OnLyricSolidPresetClick" />
                                                                <Button Width="28" Height="28" Padding="0" CornerRadius="14" Background="#450A0A" Tag="#450A0A" Click="OnLyricSolidPresetClick" />
                                                            </StackPanel>
                                                            <TextBox x:Name="LyricSolidColorHexBox" PlaceholderText="#1A1A1A" Text="#1A1A1A" TextChanged="OnLyricCustomColorTextChanged" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 模式 2：渐变编辑器 -->
                                                    <Border x:Name="LyricBgModeGradientPanel" Visibility="Collapsed" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <StackPanel Spacing="8">
                                                            <TextBlock Text="渐变编辑器" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox x:Name="LyricGradColor0Box" Grid.Column="0" Header="起始色" Text="#1A1A1A" TextChanged="OnLyricCustomColorTextChanged" />
                                                                <TextBox x:Name="LyricGradColor1Box" Grid.Column="1" Header="结束色" Text="#000000" TextChanged="OnLyricCustomColorTextChanged" />
                                                            </Grid>
                                                            <ComboBox x:Name="LyricGradDirectionCombo" Header="渐变方向" HorizontalAlignment="Stretch" SelectionChanged="OnLyricGradDirectionChanged">
                                                                <ComboBoxItem Content="上到下" Tag="to bottom" IsSelected="True" />
                                                                <ComboBoxItem Content="下到上" Tag="to top" />
                                                                <ComboBoxItem Content="左到右" Tag="to right" />
                                                                <ComboBoxItem Content="右到左" Tag="to left" />
                                                                <ComboBoxItem Content="左上到右下" Tag="to bottom right" />
                                                                <ComboBoxItem Content="45度角" Tag="45deg" />
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 模式 3：自定义背景图片 + 模糊度 + 明暗度 -->
                                                    <Border x:Name="LyricBgModeImagePanel" Visibility="Collapsed" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <StackPanel Spacing="10">
                                                            <TextBlock Text="上传背景图片" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="选择本地图片" Style="{StaticResource BrandPrimaryButtonStyle}" Click="OnPickLyricBgImageClick" FontSize="12" />
                                                                <Button Grid.Column="1" Content="清除" Click="OnClearLyricBgImageClick" FontSize="12" />
                                                            </Grid>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="模糊度 (0 - 20px)" FontSize="11" Foreground="#CCFFFFFF" />
                                                                <Slider x:Name="LyricBgBlurSlider" Minimum="0" Maximum="20" StepFrequency="1" Value="0" ValueChanged="OnLyricBgImageFilterChanged" />
                                                            </StackPanel>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="明暗度 (暗 · 正常 · 亮)" FontSize="11" Foreground="#CCFFFFFF" />
                                                                <Slider x:Name="LyricBgBrightnessSlider" Minimum="10" Maximum="200" StepFrequency="5" Value="100" ValueChanged="OnLyricBgImageFilterChanged" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 模式 4：自定义 CSS 样式 -->
                                                    <Border x:Name="LyricBgModeCssPanel" Visibility="Collapsed" Background="#0DFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                        <StackPanel Spacing="6">
                                                            <TextBlock Text="自定义 CSS 样式" FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF" />
                                                            <TextBox
                                                                x:Name="LyricCustomCssBox"
                                                                AcceptsReturn="True"
                                                                Height="68"
                                                                TextWrapping="Wrap"
                                                                PlaceholderText="例如: linear-gradient(135deg, #0f172a, #064e3b)"
                                                                TextChanged="OnLyricCustomColorTextChanged" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- 全屏切换按钮 -->
                <Button
                    x:Name="MusicFullFullscreenBtn"
                    Width="36"
                    Height="36"
                    Padding="0"
                    CornerRadius="8"
                    Background="#318E8E8E"
                    BorderThickness="0"
                    Click="OnToggleMusicFullWindowFullscreenClick"
                    ToolTipService.ToolTip="切换全屏">
                    <FontIcon x:Name="MusicFullFullscreenIcon" Glyph="&#xE740;" FontSize="14" Foreground="White" />
                </Button>
            </StackPanel>

            <!-- 核心双栏内容区 (对应 MusicFull.vue .content-wrapper：左侧 3D 封面+歌曲信息+SimplePlayBar，右侧滚动歌词+右下角歌词微调) -->
            <Grid
                x:Name="MusicFullContentWrapper"
                MaxWidth="1520"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="56,36,56,28"
                ColumnSpacing="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ImmersiveLeftCol" Width="2*" />
                    <ColumnDefinition x:Name="ImmersiveRightCol" Width="3*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：3D 视差封面 (Cover3D) + 歌曲名/可点击歌手 + 迷你播放栏 (SimplePlayBar) -->
                <StackPanel
                    x:Name="ImmersiveCoverPanel"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="18">
                    <!-- 3D 视差专辑封面容器 (对应 Cover3D.vue) -->
                    <Border
                        x:Name="Cover3DBorder"
                        Width="336"
                        Height="336"
                        CornerRadius="16"
                        Background="#1F2937"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        PointerEntered="OnCover3DPointerEntered"
                        PointerMoved="OnCover3DPointerMoved"
                        PointerExited="OnCover3DPointerExited">
                        <Border.Projection>
                            <PlaneProjection x:Name="Cover3DProjection" RotationX="0" RotationY="0" />
                        </Border.Projection>
                        <Grid>
                            <Image x:Name="ImmersiveCoverImg" Stretch="UniformToFill" />
                            <Border
                                x:Name="Cover3DShineOverlay"
                                CornerRadius="16"
                                Opacity="0"
                                IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush x:Name="Cover3DShineBrush" StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0.0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 歌曲名与歌手 (对应 .music-info) -->
                    <StackPanel x:Name="ImmersiveMusicInfoPanel" Width="360" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock
                            x:Name="ImmersiveSongTitle"
                            Text="未在播放"
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="White"
                            TextAlignment="Center"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ImmersiveArtistBtn"
                            Click="OnImmersiveArtistClick"
                            Style="{StaticResource TransportIconButtonStyle}"
                            HorizontalAlignment="Center"
                            Padding="8,2"
                            ToolTipService.ToolTip="点击查看歌手详情">
                            <TextBlock
                                x:Name="ImmersiveSongArtist"
                                Text="选择一首歌曲开始聆听"
                                FontSize="16"
                                Foreground="#CCFFFFFF"
                                TextAlignment="Center"
                                MaxLines="2"
                                TextTrimming="CharacterEllipsis" />
                        </Button>

                        <!-- 播放详情页音质级别胶囊（支持直接点击切换在线音质） -->
                        <Button
                            x:Name="ImmersiveQualityBadgeBtn"
                            HorizontalAlignment="Center"
                            Padding="10,3"
                            MinHeight="0"
                            MinWidth="0"
                            CornerRadius="6"
                            Background="#2410B981"
                            BorderBrush="#5510B981"
                            BorderThickness="1"
                            ToolTipService.ToolTip="当前播放音质（点击可切换在线音质等级）">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock
                                    x:Name="ImmersiveQualityBadgeText"
                                    Text="无损 FLAC"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#34D399" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="#34D399" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="标准 (128k)" Tag="standard" Click="OnPlayBarQualityMenuClick" />
                                    <MenuFlyoutItem Text="较高 (192k)" Tag="higher" Click="OnPlayBarQualityMenuClick" />
                                    <MenuFlyoutItem Text="极高 (320k)" Tag="exhigh" Click="OnPlayBarQualityMenuClick" />
                                    <MenuFlyoutItem Text="无损 (FLAC)" Tag="lossless" Click="OnPlayBarQualityMenuClick" />
                                    <MenuFlyoutItem Text="Hi-Res" Tag="hires" Click="OnPlayBarQualityMenuClick" />
                                    <MenuFlyoutItem Text="高清臻音" Tag="jyeffect" Click="OnPlayBarQualityMenuClick" />
                                    <MenuFlyoutItem Text="沉浸环绕声" Tag="sky" Click="OnPlayBarQualityMenuClick" />
                                    <MenuFlyoutItem Text="超清母带" Tag="jymaster" Click="OnPlayBarQualityMenuClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- 内嵌迷你播放栏 (1:1 对应 SimplePlayBar.vue) -->
                    <StackPanel
                        x:Name="MusicFullSimplePlayBar"
                        Width="360"
                        Spacing="8"
                        Margin="0,4,0,0">
                        <!-- 顶部：进度条与时间显示 -->
                        <StackPanel Spacing="2">
                            <Slider
                                x:Name="SimplePlayBarSeekSlider"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center"
                                ValueChanged="OnSeekSliderValueChanged" />
                            <Grid>
                                <TextBlock
                                    x:Name="SimplePlayBarPositionText"
                                    Text="00:00"
                                    FontSize="13"
                                    Foreground="#99FFFFFF"
                                    HorizontalAlignment="Left" />
                                <TextBlock
                                    x:Name="SimplePlayBarDurationText"
                                    Text="00:00"
                                    FontSize="13"
                                    Foreground="#99FFFFFF"
                                    HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <!-- 中部：左=播放模式，中=上一首 / 46x46 主题色圆形播放键 / 下一首，右=播放列表抽屉 -->
                        <Grid Margin="0,2,0,2">
                            <Button
                                x:Name="SimplePlayBarModeBtn"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Padding="0"
                                Style="{StaticResource TransportIconButtonStyle}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="OnCyclePlayModeClick"
                                ToolTipService.ToolTip="切换播放模式">
                                <FontIcon x:Name="SimplePlayBarModeIcon" Glyph="&#xE8EE;" FontSize="16" Foreground="White" />
                            </Button>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="24">
                                <Button
                                    x:Name="SimplePlayBarPrevBtn"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Style="{StaticResource TransportPrevNextButtonStyle}"
                                    Click="OnPrevButtonClick"
                                    ToolTipService.ToolTip="上一首">
                                    <FontIcon x:Name="SimplePlayBarPrevIcon" Glyph="&#xE892;" FontSize="18" Foreground="White" />
                                </Button>

                                <Button
                                    x:Name="SimplePlayBarPlayBtn"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="23"
                                    Style="{StaticResource AccentCirclePlayButtonStyle}"
                                    Click="OnPlayPauseButtonClick"
                                    ToolTipService.ToolTip="播放 / 暂停">
                                    <FontIcon x:Name="SimplePlayBarPlayIcon" Glyph="&#xE768;" FontSize="18" Foreground="White" />
                                </Button>

                                <Button
                                    x:Name="SimplePlayBarNextBtn"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Style="{StaticResource TransportPrevNextButtonStyle}"
                                    Click="OnNextButtonClick"
                                    ToolTipService.ToolTip="下一首">
                                    <FontIcon x:Name="SimplePlayBarNextIcon" Glyph="&#xE893;" FontSize="18" Foreground="White" />
                                </Button>
                            </StackPanel>

                            <Button
                                x:Name="SimplePlayBarQueueBtn"
                                Width="34"
                                Height="34"
                                CornerRadius="17"
                                Padding="0"
                                Style="{StaticResource TransportIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="OnToggleQueueDrawerClick"
                                ToolTipService.ToolTip="打开播放列表">
                                <FontIcon x:Name="SimplePlayBarQueueIcon" Glyph="&#xE90B;" FontSize="16" Foreground="White" />
                            </Button>
                        </Grid>

                        <!-- 底部：右侧静音按钮 + 音量滑块（支持鼠标滚轮调节音量） -->
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Background="Transparent"
                            PointerWheelChanged="OnSimplePlayBarVolumeWheel">
                            <Button
                                x:Name="SimplePlayBarMuteBtn"
                                Width="30"
                                Height="30"
                                MinWidth="30"
                                MinHeight="30"
                                Padding="0"
                                CornerRadius="15"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Click="OnSimplePlayBarMuteClick"
                                ToolTipService.ToolTip="静音 / 取消静音">
                                <FontIcon x:Name="SimplePlayBarVolumeIcon" Glyph="&#xE767;" FontSize="14" Foreground="White" />
                            </Button>
                            <Slider
                                x:Name="SimplePlayBarVolumeSlider"
                                Width="96"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                VerticalAlignment="Center"
                                PointerWheelChanged="OnSimplePlayBarVolumeWheel"
                                ValueChanged="OnVolumeSliderValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：歌词滚动区 + 隐藏封面时的顶部歌名头 + 右下角竖向歌词时间微调控件 -->
                <Grid
                    x:Name="ImmersiveLyricRightPanel"
                    Grid.Column="1"
                    RowSpacing="8"
                    PointerEntered="OnLyricAreaPointerEntered"
                    PointerExited="OnLyricAreaPointerExited">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 当“隐藏封面”开启时在歌词顶部显示歌曲标题与歌手 (对应 MusicFull.vue .music-info-header) -->
                    <StackPanel
                        x:Name="ImmersiveHiddenCoverHeader"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Spacing="4"
                        Margin="16,8,16,8">
                        <TextBlock
                            x:Name="ImmersiveHiddenCoverTitle"
                            Text="未在播放"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="White"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="ImmersiveHiddenCoverArtist"
                            Text=""
                            FontSize="18"
                            Foreground="#CCFFFFFF" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="ImmersiveLyricListView"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ShowsScrollingPlaceholders="False"
                            ItemClick="OnImmersiveLyricLineClick">
                            <ListView.Header>
                                <Border Height="160" />
                            </ListView.Header>
                            <ListView.Footer>
                                <Border Height="180" />
                            </ListView.Footer>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LyricLine">
                                    <Border
                                        Padding="{x:Bind LinePadding, Mode=OneWay}"
                                        CornerRadius="12"
                                        Background="Transparent">
                                        <StackPanel
                                            Spacing="4"
                                            HorizontalAlignment="{x:Bind HorizontalAlignmentValue, Mode=OneWay}"
                                            Opacity="{x:Bind LineOpacity, Mode=OneWay}">
                                            <TextBlock
                                                Text="{x:Bind Text}"
                                                FontSize="{x:Bind DisplayFontSize, Mode=OneWay}"
                                                FontWeight="{x:Bind LineFontWeight, Mode=OneWay}"
                                                CharacterSpacing="{x:Bind CharacterSpacingValue, Mode=OneWay}"
                                                Foreground="{x:Bind LineForeground, Mode=OneWay}"
                                                TextAlignment="{x:Bind TextAlignmentValue, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind TranslationText}"
                                                Visibility="{x:Bind TranslationVisibility, Mode=OneWay}"
                                                FontSize="{x:Bind TranslationFontSize, Mode=OneWay}"
                                                CharacterSpacing="{x:Bind CharacterSpacingValue, Mode=OneWay}"
                                                Foreground="{x:Bind TranslationForeground, Mode=OneWay}"
                                                TextAlignment="{x:Bind TextAlignmentValue, Mode=OneWay}"
                                                Opacity="0.78"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 无歌词提示 -->
                        <TextBlock
                            x:Name="ImmersiveEmptyLyricText"
                            Text="暂无歌词"
                            Visibility="Collapsed"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#99FFFFFF"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />

                        <!-- 右下角竖向歌词时间轴矫正组件 (1:1 对应 LyricCorrectionControl.vue：悬停歌词区时渐显，步进 ±0.2s) -->
                        <StackPanel
                            x:Name="ImmersiveLyricCorrectionPanel"
                            Orientation="Vertical"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,40"
                            Opacity="0">
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="8"
                                Background="#66262626"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                Click="OnLyricOffsetMinusClick"
                                ToolTipService.ToolTip="减去 0.2 秒">
                                <FontIcon Glyph="&#xE738;" FontSize="12" Foreground="White" />
                            </Button>

                            <Button
                                x:Name="LyricOffsetBadgeBtn"
                                Padding="6,2"
                                CornerRadius="6"
                                Background="#66262626"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Click="OnLyricOffsetResetClick"
                                ToolTipService.ToolTip="点击重置为 0.0s">
                                <TextBlock
                                    x:Name="LyricOffsetBadgeText"
                                    Text="0.0s"
                                    FontSize="11"
                                    FontFamily="Consolas"
                                    Foreground="#E5E7EB" />
                            </Button>

                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                CornerRadius="8"
                                Background="#66262626"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                Click="OnLyricOffsetPlusClick"
                                ToolTipService.ToolTip="增加 0.2 秒">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="White" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== 4. 底部 Fluent v2 现代媒体播放栏 (PlayBar) ==================== -->
        <Border
            x:Name="BottomPlayBarBorder"
            Grid.Row="2"
            Padding="18,2,18,8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶边播放进度条 -->
                <Grid Grid.Row="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionTimeText" Grid.Column="0" Text="00:00" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <Slider
                        x:Name="SeekSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        VerticalAlignment="Center"
                        ValueChanged="OnSeekSliderValueChanged" />
                    <TextBlock x:Name="DurationTimeText" Grid.Column="2" Text="00:00" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- 主控制行 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- 左下角：圆角封面（带悬停展开/收起箭头遮罩，对应 PlayBar.vue .play-bar-img-wrapper）、曲名、歌手、音源胶囊、收藏矢量图标 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <Button
                            CornerRadius="8"
                            Style="{StaticResource CoverOverlayButtonStyle}"
                            Click="OnToggleImmersiveLyricClick"
                            PointerEntered="OnBottomCoverPointerEntered"
                            PointerExited="OnBottomCoverPointerExited"
                            ToolTipService.ToolTip="展开/收起播放详情页">
                            <Grid Width="48" Height="48">
                                <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image x:Name="BottomCoverImg" Stretch="UniformToFill" />
                                </Border>
                                <Border
                                    x:Name="BottomCoverHoverArrowOverlay"
                                    CornerRadius="8"
                                    Background="#88000000"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                        <FontIcon x:Name="BottomCoverHoverArrowIcon" Glyph="&#xE70E;" FontSize="13" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="BottomCoverHoverArrowText" Text="展开" FontSize="10" Foreground="White" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>

                        <StackPanel VerticalAlignment="Center" MaxWidth="248" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="BottomSongTitleText" Text="未在播放" FontWeight="SemiBold" MaxWidth="165" TextTrimming="CharacterEllipsis" />
                                <Border Background="{StaticResource BrandAccentSubtleBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BottomRateBadgeText" Text="1.0x" FontSize="10" Foreground="{StaticResource BrandAccentBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock x:Name="BottomArtistText" Text="选择一首歌曲开始聆听" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="105" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Background="{StaticResource BrandAccentSubtleBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BottomPlatformBadgeText" Text="NETEASE" FontSize="9" Foreground="{StaticResource BrandAccentBrush}" FontWeight="Bold" />
                                </Border>
                                <Button
                                    x:Name="BottomQualityBadgeBtn"
                                    Padding="6,1"
                                    MinHeight="0"
                                    MinWidth="0"
                                    CornerRadius="4"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrandAccentSubtleBrush}"
                                    BorderBrush="#4010B981"
                                    BorderThickness="1"
                                    ToolTipService.ToolTip="当前播放音质（点击选择在线音质级别）">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock
                                            x:Name="BottomQualityBadgeText"
                                            Text="无损 FLAC"
                                            FontSize="9"
                                            Foreground="{StaticResource BrandAccentBrush}"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                                        <FontIcon Glyph="&#xE70D;" FontSize="7" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <MenuFlyout Placement="Top">
                                            <MenuFlyoutItem Text="标准 (128k)" Tag="standard" Click="OnPlayBarQualityMenuClick" />
                                            <MenuFlyoutItem Text="较高 (192k)" Tag="higher" Click="OnPlayBarQualityMenuClick" />
                                            <MenuFlyoutItem Text="极高 (320k)" Tag="exhigh" Click="OnPlayBarQualityMenuClick" />
                                            <MenuFlyoutItem Text="无损 (FLAC)" Tag="lossless" Click="OnPlayBarQualityMenuClick" />
                                            <MenuFlyoutItem Text="Hi-Res" Tag="hires" Click="OnPlayBarQualityMenuClick" />
                                            <MenuFlyoutItem Text="高清臻音" Tag="jyeffect" Click="OnPlayBarQualityMenuClick" />
                                            <MenuFlyoutItem Text="沉浸环绕声" Tag="sky" Click="OnPlayBarQualityMenuClick" />
                                            <MenuFlyoutItem Text="超清母带" Tag="jymaster" Click="OnPlayBarQualityMenuClick" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="BottomInlineLyricText" Text="" FontSize="11" Foreground="{StaticResource BrandAccentBrush}" MaxWidth="235" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            x:Name="BottomLikeBtn"
                            Style="{StaticResource TransportIconButtonStyle}"
                            Click="OnToggleCurrentSongLikeClick"
                            ToolTipService.ToolTip="喜欢 / 取消喜欢当前歌曲">
                            <FontIcon x:Name="BottomLikeIcon" Glyph="&#xEB51;" FontSize="15" />
                        </Button>
                    </StackPanel>

                    <!-- 中部：Fluent 媒体传输按钮组（循环模式、上一首、圆形主播放键、下一首） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <Button
                            x:Name="PlayModeBtn"
                            Style="{StaticResource TransportIconButtonStyle}"
                            Click="OnCyclePlayModeClick"
                            ToolTipService.ToolTip="切换播放模式（列表循环 / 单曲循环 / 随机 / 心动模式）">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="PlayModeIcon" Glyph="&#xE8EE;" FontSize="14" />
                                <TextBlock x:Name="PlayModeText" Text="列表循环" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button
                            Style="{StaticResource TransportPrevNextButtonStyle}"
                            Click="OnPrevButtonClick"
                            ToolTipService.ToolTip="上一首 (Ctrl+Left)">
                            <FontIcon Glyph="&#xE892;" FontSize="16" />
                        </Button>

                        <Button
                            x:Name="PlayPauseMainBtn"
                            Style="{StaticResource AccentCirclePlayButtonStyle}"
                            Click="OnPlayPauseButtonClick"
                            ToolTipService.ToolTip="播放 / 暂停 (Space)">
                            <FontIcon x:Name="PlayPauseMainIcon" Glyph="&#xE768;" FontSize="16" Foreground="White" />
                        </Button>

                        <Button
                            Style="{StaticResource TransportPrevNextButtonStyle}"
                            Click="OnNextButtonClick"
                            ToolTipService.ToolTip="下一首 (Ctrl+Right)">
                            <FontIcon Glyph="&#xE893;" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <!-- 右下角：切源、下载、倍速、EQ/定时、桌面歌词、音量、队列抽屉 (全部采用无边框 Segoe Fluent 矢量图标) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                        <!-- 重新解析音源菜单 -->
                        <Button Style="{StaticResource TransportIconButtonStyle}" ToolTipService.ToolTip="切换当前歌曲音源">
                            <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="网易云官方直连 (Netease)" Tag="netease" Click="OnSwitchAudioSourceClick" />
                                    <MenuFlyoutItem Text="QQ 音乐音源 (QQ)" Tag="qq" Click="OnSwitchAudioSourceClick" />
                                    <MenuFlyoutItem Text="酷我无损音源 (Kuwo)" Tag="kuwo" Click="OnSwitchAudioSourceClick" />
                                    <MenuFlyoutItem Text="酷狗音乐音源 (Kugou)" Tag="kugou" Click="OnSwitchAudioSourceClick" />
                                    <MenuFlyoutItem Text="咪咕音乐音源 (Migu)" Tag="migu" Click="OnSwitchAudioSourceClick" />
                                    <MenuFlyoutItem Text="GD 音乐台内置解析 (GDMusic)" Tag="gdmusic" Click="OnSwitchAudioSourceClick" />
                                    <MenuFlyoutItem Text="JOOX 音乐音源 (JOOX)" Tag="joox" Click="OnSwitchAudioSourceClick" />
                                    <MenuFlyoutItem Text="PyNCMD 镜像源" Tag="pyncmd" Click="OnSwitchAudioSourceClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 下载当前播放歌曲 -->
                        <Button Style="{StaticResource TransportIconButtonStyle}" Click="OnDownloadCurrentSongClick" ToolTipService.ToolTip="下载当前播放歌曲">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                        </Button>

                        <!-- 倍速播放菜单 -->
                        <Button Style="{StaticResource TransportIconButtonStyle}" ToolTipService.ToolTip="倍速播放 (0.5x ~ 2.0x)">
                            <FontIcon Glyph="&#xEC57;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="0.5x 慢速" Tag="0.5" Click="OnPlaybackRateMenuClick" />
                                    <MenuFlyoutItem Text="0.75x 稍慢" Tag="0.75" Click="OnPlaybackRateMenuClick" />
                                    <MenuFlyoutItem Text="1.0x 正常速度" Tag="1.0" Click="OnPlaybackRateMenuClick" />
                                    <MenuFlyoutItem Text="1.25x 稍快" Tag="1.25" Click="OnPlaybackRateMenuClick" />
                                    <MenuFlyoutItem Text="1.5x 快速" Tag="1.5" Click="OnPlaybackRateMenuClick" />
                                    <MenuFlyoutItem Text="2.0x 倍速" Tag="2.0" Click="OnPlaybackRateMenuClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 10段独立频点滑块 EQ（1:1 还原原版 EQControl.vue 横排10列纵向推子 + 9种预设标签 + 支持鼠标滚轮微调）+ 定时关闭 -->
                        <Button Style="{StaticResource TransportIconButtonStyle}" ToolTipService.ToolTip="均衡器与睡眠定时">
                            <FontIcon Glyph="&#xE9E9;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout>
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="MaxWidth" Value="700" />
                                            <Setter Property="MaxHeight" Value="580" />
                                            <Setter Property="Padding" Value="22,20" />
                                            <Setter Property="CornerRadius" Value="14" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Width="620" Spacing="16">
                                        <!-- eq-header：标题与开关 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="均衡器" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" />
                                            <ToggleSwitch
                                                x:Name="EqEnableToggle"
                                                Grid.Column="1"
                                                MinWidth="0"
                                                OffContent="关闭"
                                                OnContent="开启"
                                                VerticalAlignment="Center"
                                                Toggled="OnEqEnableToggled" />
                                        </Grid>

                                        <!-- eq-presets：9种原版音效预设胶囊标签 -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="EqPresetFlatBtn" Content="平坦" Tag="flat" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetPopBtn" Content="流行" Tag="pop" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetRockBtn" Content="摇滚" Tag="rock" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetClassicalBtn" Content="古典" Tag="classical" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetJazzBtn" Content="爵士" Tag="jazz" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetHiphopBtn" Content="嘻哈" Tag="hiphop" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetVocalBtn" Content="人声" Tag="vocal" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetDanceBtn" Content="舞曲" Tag="dance" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                            <Button x:Name="EqPresetAcousticBtn" Content="原声" Tag="acoustic" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="14" Padding="12,5" FontSize="12" Click="OnEqPresetTagClick" />
                                        </StackPanel>

                                        <!-- eq-sliders：原版横排 10 列频段纵向推子 (31Hz ~ 16kHz，支持鼠标滚轮调节) -->
                                        <Border
                                            Height="280"
                                            Padding="10,14"
                                            CornerRadius="10"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <Grid ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 31Hz -->
                                                <Grid Grid.Column="0" Background="Transparent" Tag="0" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="31Hz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand0" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="0" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal0" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 62Hz -->
                                                <Grid Grid.Column="1" Background="Transparent" Tag="1" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="62Hz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand1" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="1" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal1" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 125Hz -->
                                                <Grid Grid.Column="2" Background="Transparent" Tag="2" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="125Hz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand2" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="2" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal2" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 250Hz -->
                                                <Grid Grid.Column="3" Background="Transparent" Tag="3" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="250Hz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand3" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="3" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal3" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 500Hz -->
                                                <Grid Grid.Column="4" Background="Transparent" Tag="4" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="500Hz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand4" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="4" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal4" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 1kHz -->
                                                <Grid Grid.Column="5" Background="Transparent" Tag="5" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="1kHz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand5" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="5" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal5" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 2kHz -->
                                                <Grid Grid.Column="6" Background="Transparent" Tag="6" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="2kHz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand6" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="6" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal6" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 4kHz -->
                                                <Grid Grid.Column="7" Background="Transparent" Tag="7" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="4kHz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand7" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="7" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal7" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 8kHz -->
                                                <Grid Grid.Column="8" Background="Transparent" Tag="8" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="8kHz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand8" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="8" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal8" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>

                                                <!-- 16kHz -->
                                                <Grid Grid.Column="9" Background="Transparent" Tag="9" PointerWheelChanged="OnEqBandPointerWheelChanged">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="16kHz" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <Slider x:Name="EqBand9" Grid.Row="1" Orientation="Vertical" Minimum="-12" Maximum="12" StepFrequency="0.1" Value="0" Tag="9" Margin="0,10" HorizontalAlignment="Center" VerticalAlignment="Stretch" ValueChanged="OnEqBandSliderChanged" />
                                                    <TextBlock x:Name="EqBandVal9" Grid.Row="2" Text="0dB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- 睡眠定时行 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="睡眠定时停止播放" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="15分钟" Tag="15" Click="OnSleepTimerButtonClick" Padding="10,4" FontSize="12" />
                                                <Button Content="30分钟" Tag="30" Click="OnSleepTimerButtonClick" Padding="10,4" FontSize="12" />
                                                <Button Content="60分钟" Tag="60" Click="OnSleepTimerButtonClick" Padding="10,4" FontSize="12" />
                                                <Button Content="取消定时" Tag="0" Click="OnSleepTimerButtonClick" Padding="10,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- 桌面歌词开关 -->
                        <Button Style="{StaticResource TransportIconButtonStyle}" Click="OnToggleDesktopLyricClick" ToolTipService.ToolTip="开关桌面透明悬浮歌词">
                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                        </Button>

                        <!-- 音量静音按钮与滑块（支持鼠标滚轮调节音量） -->
                        <StackPanel
                            x:Name="BottomVolumePanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="2"
                            Background="Transparent"
                            PointerWheelChanged="OnBottomPlayBarVolumeWheel">
                            <Button
                                x:Name="BottomMuteBtn"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Padding="6,6"
                                MinWidth="32"
                                Click="OnSimplePlayBarMuteClick"
                                ToolTipService.ToolTip="静音 / 取消静音（滚轮可调节音量）">
                                <FontIcon x:Name="BottomVolumeIcon" Glyph="&#xE767;" FontSize="14" />
                            </Button>
                            <Slider
                                x:Name="VolumeSlider"
                                Width="80"
                                Minimum="0"
                                Maximum="100"
                                Value="80"
                                VerticalAlignment="Center"
                                PointerWheelChanged="OnBottomPlayBarVolumeWheel"
                                ValueChanged="OnVolumeSliderValueChanged" />
                        </StackPanel>

                        <!-- 当前播放队列抽屉 -->
                        <Button Style="{StaticResource TransportIconButtonStyle}" Click="OnToggleQueueDrawerClick" ToolTipService.ToolTip="展开 / 收起播放队列">
                            <FontIcon Glyph="&#xE90B;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 5. 客户端内 QQ 快捷登录器模态框 (先选择本机已登录 QQ 账号再确认登录 / 支持切换内嵌网页登录器) ==================== -->
        <Grid
            x:Name="QqQuickLoginModalOverlay"
            Grid.Row="0"
            Grid.RowSpan="3"
            Canvas.ZIndex="950"
            Visibility="Collapsed"
            Background="#88000000"
            Tapped="OnQqQuickLoginModalBackdropTapped">
            <Border
                Width="520"
                Height="510"
                CornerRadius="16"
                Padding="22,18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Tapped="OnModalCardInnerTapped">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE77B;" FontSize="17" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="QQ 音乐快捷登录器" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="30"
                            Height="30"
                            Padding="0"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCloseQqQuickLoginModalClick">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- 模式切换胶囊栏：本机 QQ 账号选择 | 内嵌网页快速授权 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="QqLauncherLocalTabBtn"
                            Content="选择本机已登录 QQ"
                            Tag="local"
                            Click="OnQqLauncherTabSwitchClick"
                            Style="{StaticResource BrandPrimaryButtonStyle}"
                            CornerRadius="8"
                            Padding="14,6" />
                        <Button
                            x:Name="QqLauncherPasswordTabBtn"
                            Content="手动账号密码登录"
                            Tag="password"
                            Click="OnQqLauncherTabSwitchClick"
                            Style="{StaticResource SecondaryTabButtonStyle}"
                            CornerRadius="8"
                            Padding="14,6" />
                        <Button
                            x:Name="QqLauncherWebTabBtn"
                            Content="内嵌网页快速授权"
                            Tag="web"
                            Click="OnQqLauncherTabSwitchClick"
                            Style="{StaticResource SecondaryTabButtonStyle}"
                            CornerRadius="8"
                            Padding="14,6" />
                    </StackPanel>

                    <TextBlock
                        x:Name="QqQuickLoginModalStatusText"
                        Grid.Row="2"
                        Text="请选择要用于登录 QQ 音乐的本机已登录 QQ 账号，选好后点击下方「授权并登录」按钮："
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <!-- 主内容区 -->
                    <Grid Grid.Row="3">
                        <!-- 面板 A：本机已登录 QQ 账号选择列表 + 底部确认登录按钮 -->
                        <Grid x:Name="QqLauncherLocalPanel" Visibility="Visible" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                CornerRadius="12"
                                Padding="10"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid>
                                    <ListView
                                        x:Name="ModalLocalQqAccountsListView"
                                        ItemsSource="{x:Bind ViewModel.LocalQqAccounts}"
                                        SelectionMode="None"
                                        IsItemClickEnabled="True"
                                        ItemClick="OnLocalQqAccountItemSelectClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:LocalQqAccountItem">
                                                <Border
                                                    Padding="14,12"
                                                    Margin="0,4"
                                                    CornerRadius="10"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <Image Source="{x:Bind AvatarUrl}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                            <TextBlock Text="{x:Bind DisplayNickname}" FontSize="15" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind DisplayUin}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" />
                                                        </StackPanel>
                                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                                            <Border
                                                                Visibility="{x:Bind SelectedBadgeVisibility, Mode=OneWay}"
                                                                Background="{StaticResource BrandAccentBrush}"
                                                                CornerRadius="8"
                                                                Padding="10,5">
                                                                <TextBlock Text="✓ 当前已选" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                            </Border>
                                                            <Border
                                                                Visibility="{x:Bind UnselectedBadgeVisibility, Mode=OneWay}"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                CornerRadius="8"
                                                                Padding="10,5">
                                                                <TextBlock Text="点击选择" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <StackPanel
                                        x:Name="ModalLocalQqEmptyPanel"
                                        Visibility="Collapsed"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="10">
                                        <FontIcon Glyph="&#xE77B;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="暂未在本地快速端口检测到已登录的 PC QQ" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <Button Content="切换到内嵌网页快速授权" Tag="web" Click="OnQqLauncherTabSwitchClick" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 底部确认登录与刷新操作栏 -->
                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Content="重新检测本机 QQ"
                                    Height="40"
                                    Padding="16,0"
                                    Click="OnDetectLocalQqAccountsClick" />
                                <Button
                                    x:Name="ModalConfirmLocalQqLoginBtn"
                                    Grid.Column="1"
                                    Content="授权并登录选中 QQ 账号"
                                    Height="40"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource BrandPrimaryButtonStyle}"
                                    Click="OnConfirmSelectedLocalQqLoginClick" />
                            </Grid>
                        </Grid>

                        <!-- 面板 B：内嵌 WebView2 快速授权组件 -->
                        <Border
                            x:Name="QqLauncherWebPanel"
                            Visibility="Collapsed"
                            CornerRadius="10"
                            Background="White"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <WebView2 x:Name="QqQuickLoginWebView" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 沉浸式全屏抽屉 MV 播放器 (MvPlayerOverlay — 1:1 还原 src/renderer/components/MvPlayer.vue) ==================== -->
        <Grid
            x:Name="MvPlayerOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            Canvas.ZIndex="96"
            Visibility="Collapsed"
            Background="#FA05080F"
            RequestedTheme="Dark">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部标题与控制栏（关闭按钮、MV 标题、歌手、上一部/下一部、连播/单曲循环、画质切换） -->
            <Border
                Grid.Row="0"
                Padding="20,14"
                Background="#CC000000"
                BorderBrush="#1FFFFFFF"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Click="OnCloseMvOverlayClick"
                        Width="36"
                        Height="36"
                        Padding="0"
                        CornerRadius="18"
                        Background="#1FFFFFFF"
                        BorderThickness="0"
                        ToolTipService.ToolTip="关闭 MV 播放器">
                        <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="MvOverlayTitleText"
                            Text="MV 播放器"
                            FontSize="17"
                            FontWeight="Bold"
                            Foreground="White"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="MvOverlayArtistText"
                            Text=""
                            FontSize="14"
                            Foreground="#9CA3AF"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Click="OnPrevMvClick"
                            CornerRadius="8"
                            Padding="12,6"
                            Background="#1FFFFFFF"
                            BorderThickness="0"
                            ToolTipService.ToolTip="上一部 MV">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE892;" FontSize="12" Foreground="White" />
                                <TextBlock Text="上一部" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button
                            Click="OnNextMvClick"
                            CornerRadius="8"
                            Padding="12,6"
                            Background="#1FFFFFFF"
                            BorderThickness="0"
                            ToolTipService.ToolTip="下一部 MV">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="下一部" FontSize="12" Foreground="White" />
                                <FontIcon Glyph="&#xE893;" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MvLoopModeBtn"
                            Click="OnToggleMvLoopModeClick"
                            CornerRadius="8"
                            Padding="12,6"
                            Background="#1FFFFFFF"
                            BorderThickness="0"
                            ToolTipService.ToolTip="切换 MV 连播 / 单曲循环模式">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="MvLoopModeIcon" Glyph="&#xE8EE;" FontSize="12" Foreground="#34D399" />
                                <TextBlock x:Name="MvLoopModeText" Text="列表连播" FontSize="12" Foreground="#34D399" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MvResolutionBtn"
                            CornerRadius="8"
                            Padding="12,6"
                            Background="#2610B981"
                            BorderBrush="#6610B981"
                            BorderThickness="1"
                            ToolTipService.ToolTip="切换 MV 视频画质">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="1080P 超清 (FHD)" Tag="1080" Click="OnSelectMvResolutionClick" />
                                    <MenuFlyoutItem Text="720P 高清 (HD)" Tag="720" Click="OnSelectMvResolutionClick" />
                                    <MenuFlyoutItem Text="480P 标清 (SD)" Tag="480" Click="OnSelectMvResolutionClick" />
                                    <MenuFlyoutItem Text="240P 流畅" Tag="240" Click="OnSelectMvResolutionClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <TextBlock x:Name="MvResolutionText" Text="1080P" FontSize="12" FontWeight="Bold" Foreground="#34D399" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 核心视频播放区 -->
            <Grid Grid.Row="1" Background="Black">
                <MediaPlayerElement
                    x:Name="MvMediaPlayer"
                    AreTransportControlsEnabled="True"
                    AutoPlay="True"
                    Stretch="Uniform"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />
            </Grid>
        </Grid>
    </Grid>
</Window>
