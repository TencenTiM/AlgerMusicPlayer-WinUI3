                    <!-- ==================== 视图 6：歌单/专辑详情页 (DetailView — 1:1 还原 MusicListPage.vue + StandardSongItem.vue + CompactSongItem.vue) ==================== -->
                    <Grid x:Name="DetailView" Visibility="Collapsed" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部固定粘性操作栏在滚动时的补充区或直接一体化滚动视图 -->
                        <ScrollViewer x:Name="DetailPageScrollViewer" Grid.Row="1" Padding="0,0,10,24">
                            <StackPanel Spacing="12">
                                <!-- 1. Hero Section (hero-section: 柔和氛围渐变底 + 152x152 圆角封面与悬浮播放按钮 + PLAYLIST/ALBUM 徽章 + 标题 + 创建者头像/歌曲数 + 简介) -->
                                <Border CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid>
                                        <!-- 顶部柔和主题氛围渐变层（不参与图像原始尺寸撑高） -->
                                        <Border CornerRadius="16" IsHitTestVisible="False">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#1810B981" Offset="0.0" />
                                                    <GradientStop Color="#0810B981" Offset="0.45" />
                                                    <GradientStop Color="#00000000" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Hero 主内容 -->
                                        <Grid Padding="24,20" ColumnSpacing="24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="152" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 左侧封面 + 居中播放按钮 (cover-container: 152x152 圆角封面) -->
                                            <Grid Grid.Column="0" Width="152" Height="152" VerticalAlignment="Center">
                                                <Border CornerRadius="14" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                    <Image x:Name="DetailCoverImage" Width="152" Height="152" Stretch="UniformToFill" />
                                                </Border>
                                                <Button
                                                    Click="OnPlayAllDetailSongsClick"
                                                    Width="44"
                                                    Height="44"
                                                    Padding="0"
                                                    CornerRadius="22"
                                                    Background="#E6FFFFFF"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Opacity="0.92"
                                                    ToolTipService.ToolTip="播放全部">
                                                    <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="#111827" Margin="2,0,0,0" />
                                                </Button>
                                            </Grid>

                                            <!-- 右侧歌单信息 (playlist-info) -->
                                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                                <!-- PLAYLIST / ALBUM 徽章 -->
                                                <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" Background="#2210B981">
                                                    <TextBlock x:Name="DetailBadgeTextBlock" Text="PLAYLIST" FontSize="11" FontWeight="Bold" Foreground="#10B981" CharacterSpacing="60" />
                                                </Border>

                                                <!-- 歌单大标题 -->
                                                <TextBlock
                                                    x:Name="DetailTitleText"
                                                    FontSize="24"
                                                    FontWeight="Bold"
                                                    MaxLines="2"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />

                                                <!-- 创建者头像 + 名称 + 圆点 + 音乐数量 -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border
                                                        x:Name="DetailCreatorAvatarBorder"
                                                        Width="24"
                                                        Height="24"
                                                        CornerRadius="12"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center">
                                                        <Image x:Name="DetailCreatorAvatarImage" Width="24" Height="24" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock
                                                        x:Name="DetailCreatorNameText"
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        VerticalAlignment="Center" />
                                                    <Ellipse
                                                        x:Name="DetailMetaDot"
                                                        Width="4"
                                                        Height="4"
                                                        Fill="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="DetailSongCountTextBlock"
                                                        Text="0 首音乐"
                                                        FontSize="13"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock
                                                        x:Name="DetailSubtitleText"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center"
                                                        Visibility="Collapsed" />
                                                </StackPanel>

                                                <!-- 简介 -->
                                                <TextBlock
                                                    x:Name="DetailDescText"
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="2"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 2. Action Bar (action-bar: 播放全部、收藏、批量选择 | 搜索歌曲、定位当前播放、切换紧凑/标准布局、回到顶部) -->
                                <Border
                                    Padding="14,10"
                                    CornerRadius="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧：播放全部 + 收藏 + 批量选择 -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <!-- Play All Button -->
                                            <Button
                                                Click="OnPlayAllDetailSongsClick"
                                                Style="{StaticResource BrandPrimaryButtonStyle}"
                                                CornerRadius="20"
                                                Padding="20,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                    <TextBlock Text="播放全部" FontSize="13" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Collect Button -->
                                            <Button
                                                x:Name="DetailCollectBtn"
                                                Click="OnToggleCollectDetailClick"
                                                Style="{StaticResource SecondaryTabButtonStyle}"
                                                CornerRadius="20"
                                                Padding="18,8"
                                                Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon x:Name="DetailCollectIcon" Glyph="&#xEB51;" FontSize="13" />
                                                    <TextBlock x:Name="DetailCollectText" Text="收藏" FontSize="13" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <Border Width="1" Height="24" Margin="2,0" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />

                                            <!-- 开启批量选择按钮 -->
                                            <Button
                                                x:Name="DetailStartSelectBtn"
                                                Click="OnDetailStartSelectClick"
                                                Width="36"
                                                Height="36"
                                                Padding="0"
                                                CornerRadius="18"
                                                Style="{StaticResource SecondaryTabButtonStyle}"
                                                ToolTipService.ToolTip="批量操作">
                                                <FontIcon Glyph="&#xE762;" FontSize="14" />
                                            </Button>

                                            <!-- 批量选择展开工具条 -->
                                            <StackPanel
                                                x:Name="DetailBatchActionPanel"
                                                Orientation="Horizontal"
                                                Spacing="10"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                                <CheckBox
                                                    x:Name="DetailSelectAllCheckBox"
                                                    Content="全选"
                                                    MinWidth="0"
                                                    Click="OnDetailSelectAllClick" />
                                                <Button
                                                    Click="OnDetailBatchDownloadClick"
                                                    CornerRadius="16"
                                                    Padding="14,6"
                                                    Background="#1A10B981"
                                                    BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="#10B981" />
                                                        <TextBlock x:Name="DetailBatchDownloadText" Text="下载 (0)" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Click="OnDetailBatchAddToQueueClick"
                                                    CornerRadius="16"
                                                    Padding="14,6"
                                                    Background="#1A10B981"
                                                    BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE90B;" FontSize="12" Foreground="#10B981" />
                                                        <TextBlock Text="添加到播放列表" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    Content="取消"
                                                    Click="OnDetailCancelSelectClick"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 右侧：歌单内搜索 + 定位当前播放 + 布局切换 + 回到顶部 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBox
                                                x:Name="DetailSearchBox"
                                                Width="200"
                                                CornerRadius="18"
                                                PlaceholderText="搜索歌曲..."
                                                VerticalAlignment="Center"
                                                TextChanged="OnDetailSearchTextChanged" />

                                            <Button
                                                x:Name="DetailLocateCurrentBtn"
                                                Click="OnDetailLocateCurrentSongClick"
                                                Width="36"
                                                Height="36"
                                                Padding="0"
                                                CornerRadius="18"
                                                Style="{StaticResource SecondaryTabButtonStyle}"
                                                ToolTipService.ToolTip="定位当前播放歌曲">
                                                <FontIcon Glyph="&#xE81D;" FontSize="14" />
                                            </Button>

                                            <Button
                                                x:Name="DetailToggleLayoutBtn"
                                                Click="OnDetailToggleLayoutClick"
                                                Width="36"
                                                Height="36"
                                                Padding="0"
                                                CornerRadius="18"
                                                Style="{StaticResource SecondaryTabButtonStyle}"
                                                ToolTipService.ToolTip="切换紧凑/标准布局">
                                                <FontIcon x:Name="DetailLayoutIcon" Glyph="&#xE80A;" FontSize="14" />
                                            </Button>

                                            <Button
                                                Click="OnDetailScrollToTopClick"
                                                Width="36"
                                                Height="36"
                                                Padding="0"
                                                CornerRadius="18"
                                                Style="{StaticResource SecondaryTabButtonStyle}"
                                                ToolTipService.ToolTip="回到顶部">
                                                <FontIcon Glyph="&#xE74A;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3A. 标准布局列表 (1:1 还原 StandardSongItem.vue: 48x48 圆角封面 + 标题/歌手 + 右侧 [ ♥ (▶) ] 胶囊，支持右键菜单) -->
                                <ListView
                                    x:Name="DetailSongsListView"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnDetailSongItemClick">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="Margin" Value="0,0,0,4" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SongItem">
                                            <Border
                                                Padding="12,10"
                                                CornerRadius="12"
                                                Background="Transparent"
                                                Tag="{x:Bind}"
                                                RightTapped="OnSongItemRightTapped">
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 批量选择框 (song-item-select) -->
                                                    <CheckBox
                                                        Grid.Column="0"
                                                        MinWidth="0"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{x:Bind IsBatchSelected, Mode=TwoWay}"
                                                        Visibility="{x:Bind BatchSelectVisibility, Mode=OneWay}"
                                                        Click="OnDetailSongBatchCheckClick" />

                                                    <!-- 48x48 圆角封面 (song-item-img: w-12 h-12 rounded-xl) -->
                                                    <Border
                                                        Grid.Column="1"
                                                        Width="48"
                                                        Height="48"
                                                        CornerRadius="12"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Image Source="{x:Bind CoverThumbnailUrl}" Stretch="UniformToFill" />
                                                    </Border>

                                                    <!-- 歌曲标题与歌手 (song-item-content) -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                        <Grid>
                                                            <TextBlock
                                                                Text="{x:Bind Name}"
                                                                FontSize="15"
                                                                FontWeight="Medium"
                                                                Foreground="#22C55E"
                                                                MaxLines="1"
                                                                TextTrimming="CharacterEllipsis"
                                                                Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}" />
                                                            <TextBlock
                                                                FontSize="15"
                                                                FontWeight="Medium"
                                                                MaxLines="1"
                                                                TextTrimming="CharacterEllipsis"
                                                                Visibility="{x:Bind NotPlayingVisibility, Mode=OneWay}">
                                                                <Run Text="{x:Bind Name}" />
                                                                <Run Text="{x:Bind BracketSubtitleText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </TextBlock>
                                                        </Grid>
                                                        <TextBlock
                                                            Text="{x:Bind ArtistText}"
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            MaxLines="1"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- 右侧原版胶囊操作区 (song-item-operating: [ ♥ (▶) ], w-10 h-10 播放圆钮) -->
                                                    <Border
                                                        Grid.Column="3"
                                                        Height="40"
                                                        Padding="10,0,0,0"
                                                        CornerRadius="20"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Button
                                                                Tag="{x:Bind}"
                                                                Click="OnSongLikeButtonClick"
                                                                Width="32"
                                                                Height="32"
                                                                Padding="0"
                                                                CornerRadius="16"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                ToolTipService.ToolTip="喜欢">
                                                                <Grid>
                                                                    <FontIcon
                                                                        Glyph="&#xEB52;"
                                                                        FontSize="15"
                                                                        Foreground="#EF4444"
                                                                        Visibility="{x:Bind LikedVisibility, Mode=OneWay}" />
                                                                    <FontIcon
                                                                        Glyph="&#xEB52;"
                                                                        FontSize="15"
                                                                        Foreground="#6B7280"
                                                                        Visibility="{x:Bind NotLikedVisibility, Mode=OneWay}" />
                                                                </Grid>
                                                            </Button>

                                                            <Button
                                                                Tag="{x:Bind}"
                                                                Click="OnDetailRowPlayButtonClick"
                                                                Width="38"
                                                                Height="38"
                                                                Padding="0"
                                                                CornerRadius="19"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                ToolTipService.ToolTip="播放/暂停">
                                                                <Grid Width="38" Height="38">
                                                                    <Border
                                                                        Width="38"
                                                                        Height="38"
                                                                        CornerRadius="19"
                                                                        Background="#22C55E"
                                                                        Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}">
                                                                        <FontIcon
                                                                            Glyph="{x:Bind ActivePlayGlyph, Mode=OneWay}"
                                                                            FontSize="13"
                                                                            Foreground="White"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <Border
                                                                        Width="38"
                                                                        Height="38"
                                                                        CornerRadius="19"
                                                                        Background="#2464748B"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        Visibility="{x:Bind NotPlayingVisibility, Mode=OneWay}">
                                                                        <FontIcon
                                                                            Glyph="&#xE768;"
                                                                            FontSize="13"
                                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- 3B. 紧凑布局列表 (1:1 还原 CompactSongItem.vue: 序号 + 歌名 + 歌手 + 专辑 + 时长 + 喜欢/播放/更多菜单) -->
                                <ListView
                                    x:Name="DetailCompactSongsListView"
                                    Visibility="Collapsed"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnDetailSongItemClick">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="4,1" />
                                            <Setter Property="MinHeight" Value="46" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SongItem">
                                            <Border
                                                Padding="8,6"
                                                CornerRadius="10"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                Tag="{x:Bind}"
                                                RightTapped="OnSongItemRightTapped">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="2.5*" />
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="116" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 序号 (song-item-index) -->
                                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind DisplayIndex, Mode=OneWay}"
                                                            FontSize="13"
                                                            Foreground="#22C55E"
                                                            FontWeight="Bold"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}" />
                                                        <TextBlock
                                                            Text="{x:Bind DisplayIndex, Mode=OneWay}"
                                                            FontSize="13"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            HorizontalAlignment="Center"
                                                            Visibility="{x:Bind NotPlayingVisibility, Mode=OneWay}" />
                                                    </Grid>

                                                    <!-- 批量选择框 -->
                                                    <CheckBox
                                                        Grid.Column="1"
                                                        MinWidth="0"
                                                        VerticalAlignment="Center"
                                                        IsChecked="{x:Bind IsBatchSelected, Mode=TwoWay}"
                                                        Visibility="{x:Bind BatchSelectVisibility, Mode=OneWay}"
                                                        Click="OnDetailSongBatchCheckClick" />

                                                    <!-- 歌名 -->
                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{x:Bind Name}"
                                                            FontSize="14"
                                                            Foreground="#22C55E"
                                                            MaxLines="1"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            MaxLines="1"
                                                            TextTrimming="CharacterEllipsis"
                                                            Visibility="{x:Bind NotPlayingVisibility, Mode=OneWay}">
                                                            <Run Text="{x:Bind Name}" />
                                                            <Run Text="{x:Bind BracketSubtitleText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </TextBlock>
                                                    </Grid>

                                                    <!-- 歌手 -->
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Text="{x:Bind ArtistText}"
                                                        FontSize="13"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <!-- 专辑 -->
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Text="{x:Bind AlbumText}"
                                                        FontSize="13"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center"
                                                        MaxLines="1"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <!-- 时长 -->
                                                    <TextBlock
                                                        Grid.Column="5"
                                                        Text="{x:Bind DurationText}"
                                                        FontSize="13"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right" />

                                                    <!-- 右侧操作 (song-item-operating-compact: 喜欢 + 播放圆钮 + 更多菜单) -->
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button
                                                            Tag="{x:Bind}"
                                                            Click="OnSongLikeButtonClick"
                                                            Width="28"
                                                            Height="28"
                                                            Padding="0"
                                                            CornerRadius="14"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTipService.ToolTip="喜欢">
                                                            <Grid>
                                                                <FontIcon
                                                                    Glyph="&#xEB52;"
                                                                    FontSize="14"
                                                                    Foreground="#EF4444"
                                                                    Visibility="{x:Bind LikedVisibility, Mode=OneWay}" />
                                                                <FontIcon
                                                                    Glyph="&#xEB52;"
                                                                    FontSize="14"
                                                                    Foreground="#6B7280"
                                                                    Visibility="{x:Bind NotLikedVisibility, Mode=OneWay}" />
                                                            </Grid>
                                                        </Button>

                                                        <Button
                                                            Tag="{x:Bind}"
                                                            Click="OnDetailRowPlayButtonClick"
                                                            Width="28"
                                                            Height="28"
                                                            Padding="0"
                                                            CornerRadius="14"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTipService.ToolTip="播放/暂停">
                                                            <Grid Width="28" Height="28">
                                                                <Border
                                                                    Width="28"
                                                                    Height="28"
                                                                    CornerRadius="14"
                                                                    Background="#22C55E"
                                                                    Visibility="{x:Bind PlayingIndicatorVisibility, Mode=OneWay}">
                                                                    <FontIcon
                                                                        Glyph="{x:Bind ActivePlayGlyph, Mode=OneWay}"
                                                                        FontSize="10"
                                                                        Foreground="White"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border
                                                                    Width="28"
                                                                    Height="28"
                                                                    CornerRadius="14"
                                                                    Background="#2864748B"
                                                                    Visibility="{x:Bind NotPlayingVisibility, Mode=OneWay}">
                                                                    <FontIcon
                                                                        Glyph="&#xE768;"
                                                                        FontSize="10"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>

                                                        <Button
                                                            Tag="{x:Bind}"
                                                            Click="OnSongMoreMenuButtonClick"
                                                            Width="28"
                                                            Height="28"
                                                            Padding="0"
                                                            CornerRadius="14"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTipService.ToolTip="更多操作">
                                                            <FontIcon Glyph="&#xE712;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== 视图 7：综合搜索页 (SearchView — 使用 WinUI 3 SelectorBar) ==================== -->
                    <Grid x:Name="SearchView" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock Text="综合搜索结果" FontSize="24" FontWeight="SemiBold" />
                            <NavigationView
                                x:Name="SearchNavView"
                                PaneDisplayMode="Top"
                                IsBackButtonVisible="Collapsed"
                                IsSettingsVisible="False"
                                ItemInvoked="OnSearchNavViewItemInvoked">
                                <NavigationView.MenuItems>
                                    <NavigationViewItem Content="单曲" Tag="Songs" IsSelected="True">
                                        <NavigationViewItem.Icon>
                                            <FontIcon Glyph="&#xEC4F;" />
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>
                                    <NavigationViewItem Content="歌单" Tag="Playlists">
                                        <NavigationViewItem.Icon>
                                            <FontIcon Glyph="&#xE93C;" />
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>
                                    <NavigationViewItem Content="专辑" Tag="Albums">
                                        <NavigationViewItem.Icon>
                                            <FontIcon Glyph="&#xE958;" />
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>
                                    <NavigationViewItem Content="歌手" Tag="Artists">
                                        <NavigationViewItem.Icon>
                                            <FontIcon Glyph="&#xE77B;" />
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>
                                    <NavigationViewItem Content="MV" Tag="Mvs">
                                        <NavigationViewItem.Icon>
                                            <FontIcon Glyph="&#xE8B2;" />
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>
                                    <NavigationViewItem Content="B站音源" Tag="Bili">
                                        <NavigationViewItem.Icon>
                                            <FontIcon Glyph="&#xE714;" />
                                        </NavigationViewItem.Icon>
                                    </NavigationViewItem>
                                </NavigationView.MenuItems>
                            </NavigationView>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="SearchSongsListView"
                                Visibility="Visible"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnSearchSongItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SongItem">
                                        <Grid Padding="10,8" ColumnSpacing="12" Tag="{x:Bind}" RightTapped="OnSongItemRightTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ArtistText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind AlbumText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind DurationText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                                <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnSongLikeButtonClick">
                                                    <FontIcon Glyph="&#xEB51;" FontSize="13" />
                                                </Button>
                                                <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnSongDownloadButtonClick">
                                                    <FontIcon Glyph="&#xE896;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <GridView
                                x:Name="SearchPlaylistsGrid"
                                Visibility="Collapsed"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnPlaylistCardClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlaylistItem">
                                        <Border Width="166" Margin="0,0,12,12" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <Border Width="148" Height="148" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind CoverImgUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" MaxLines="2" TextWrapping="Wrap" FontSize="13" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <GridView
                                x:Name="SearchAlbumsGrid"
                                Visibility="Collapsed"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnAlbumCardClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AlbumItem">
                                        <Border Width="166" Margin="0,0,12,12" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <Border Width="148" Height="148" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind PicUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind ArtistName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <GridView
                                x:Name="SearchArtistsGrid"
                                Visibility="Collapsed"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnArtistCardClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ArtistItem">
                                        <Border Width="124" Margin="0,0,12,12" Padding="10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <Border Width="88" Height="88" CornerRadius="44" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Center">
                                                    <Image Source="{x:Bind PicUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <GridView
                                x:Name="SearchMvsGrid"
                                Visibility="Collapsed"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnMvCardClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:MvItem">
                                        <Border Width="244" Margin="0,0,14,16" Padding="8" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <Border Width="226" Height="127" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <Image Source="{x:Bind CoverThumbnailUrl}" Stretch="UniformToFill" />
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#99000000" CornerRadius="6" Padding="7,3">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="White" />
                                                                <TextBlock Text="{x:Bind PlayCountText}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Width="38" Height="38" CornerRadius="19" Background="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE768;" FontSize="15" Foreground="#111827" Margin="2,0,0,0" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Spacing="2" Padding="2,0">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ArtistName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <ListView
                                x:Name="SearchBiliListView"
                                Visibility="Collapsed"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnBiliVideoItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BilibiliVideoItem">
                                        <Grid Padding="8" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="120" Height="72" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind Pic}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Author}" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" />
                                                <TextBlock Text="{x:Bind Bvid}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <!-- ==================== 视图 8：MV 视频页 (MvView — 1:1 还原 src/renderer/views/mv/index.vue) ==================== -->
                    <Grid x:Name="MvView" Visibility="Collapsed" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部 StickyTabPage 头部与地区分类栏（全部 / 内地 / 港台 / 欧美 / 日本 / 韩国） -->
                        <Grid Grid.Row="0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="MV" FontSize="24" FontWeight="Bold" />
                                <TextBlock x:Name="CurrentMvHeaderText" Text="精选最新热门音乐视频 · 点击卡片开启沉浸式高清播放" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel x:Name="MvAreaTabsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="MvAreaAllBtn" Content="全部" Tag="全部" Click="OnMvAreaTabClick" Style="{StaticResource BrandPrimaryButtonStyle}" CornerRadius="16" Padding="14,6" FontSize="12" />
                                <Button x:Name="MvAreaMainlandBtn" Content="内地" Tag="内地" Click="OnMvAreaTabClick" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="16" Padding="14,6" FontSize="12" />
                                <Button x:Name="MvAreaHktwBtn" Content="港台" Tag="港台" Click="OnMvAreaTabClick" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="16" Padding="14,6" FontSize="12" />
                                <Button x:Name="MvAreaWesternBtn" Content="欧美" Tag="欧美" Click="OnMvAreaTabClick" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="16" Padding="14,6" FontSize="12" />
                                <Button x:Name="MvAreaJapanBtn" Content="日本" Tag="日本" Click="OnMvAreaTabClick" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="16" Padding="14,6" FontSize="12" />
                                <Button x:Name="MvAreaKoreaBtn" Content="韩国" Tag="韩国" Click="OnMvAreaTabClick" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="16" Padding="14,6" FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- MV 卡片网格与触底加载更多 -->
                        <ScrollViewer x:Name="MvScrollViewer" Grid.Row="1" ViewChanged="OnMvScrollViewerViewChanged" Padding="0,0,10,24">
                            <StackPanel Spacing="16">
                                <GridView
                                    x:Name="MvGridView"
                                    SelectionMode="None"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnMvCardClick">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MvItem">
                                            <Border Width="244" Margin="0,0,14,16" Padding="8" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <StackPanel Spacing="8">
                                                    <Border Width="226" Height="127" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <Image Source="{x:Bind CoverThumbnailUrl}" Stretch="UniformToFill" />
                                                            <!-- 右上角播放量徽章 -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="#99000000" CornerRadius="6" Padding="7,3">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <FontIcon Glyph="&#xE768;" FontSize="9" Foreground="White" />
                                                                    <TextBlock Text="{x:Bind PlayCountText}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- 居中播放悬浮圆钮 -->
                                                            <Border Width="40" Height="40" CornerRadius="20" Background="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="#111827" Margin="2,0,0,0" />
                                                            </Border>
                                                            <!-- 右下角时长 -->
                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Background="#99000000" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{x:Bind DurationText}" FontSize="10" Foreground="#E5E7EB" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Spacing="3" Padding="2,0">
                                                        <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="Bold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ArtistName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <!-- 底部加载更多按钮 -->
                                <Button
                                    x:Name="MvLoadMoreBtn"
                                    Content="加载更多 MV"
                                    Click="OnLoadMoreMvClick"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SecondaryTabButtonStyle}"
                                    CornerRadius="18"
                                    Padding="24,8" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== 视图 9：B站音乐独立专区 (BilibiliView) ==================== -->
                    <Grid x:Name="BilibiliView" Visibility="Collapsed" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="10">
                            <TextBlock Text="Bilibili 音乐与分P音频流直解" FontSize="24" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBox x:Name="BiliInputBox" Width="380" PlaceholderText="输入 B站关键词 或 BV号 (如 BV1uv411q7Mv)..." />
                                <Button Content="搜索 / 解析 B站音频" Click="OnBiliSearchButtonClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <ListView
                            x:Name="BiliDedicatedListView"
                            Grid.Row="1"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnBiliVideoItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BilibiliVideoItem">
                                    <Grid Padding="8" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="128" Height="76" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <Image Source="{x:Bind Pic}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Author}" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" />
                                            <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- ==================== 视图 10：收藏与历史 (HistoryFavoriteView — 使用 WinUI 3 SelectorBar) ==================== -->
                    <Grid x:Name="HistoryFavoriteView" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="我的收藏与播放历史" FontSize="24" FontWeight="SemiBold" />
                                <NavigationView
                                    x:Name="HistoryFavNavView"
                                    PaneDisplayMode="Top"
                                    IsBackButtonVisible="Collapsed"
                                    IsSettingsVisible="False"
                                    ItemInvoked="OnHistoryFavNavViewItemInvoked">
                                    <NavigationView.MenuItems>
                                        <NavigationViewItem Content="我喜欢的音乐" Tag="Fav" IsSelected="True">
                                            <NavigationViewItem.Icon>
                                                <FontIcon Glyph="&#xEB51;" />
                                            </NavigationViewItem.Icon>
                                        </NavigationViewItem>
                                        <NavigationViewItem Content="最近播放历史" Tag="History">
                                            <NavigationViewItem.Icon>
                                                <FontIcon Glyph="&#xE81C;" />
                                            </NavigationViewItem.Icon>
                                        </NavigationViewItem>
                                    </NavigationView.MenuItems>
                                </NavigationView>
                            </StackPanel>
                            <Button Grid.Column="1" Content="清空播放历史" Click="OnClearHistoryClick" VerticalAlignment="Bottom" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="FavoriteSongsListView"
                                Visibility="Visible"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnFavoriteSongItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SongItem">
                                        <Grid Padding="10,8" ColumnSpacing="12" Tag="{x:Bind}" RightTapped="OnSongItemRightTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ArtistText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="取消收藏" Tag="{x:Bind}" Click="OnSongLikeButtonClick" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <ListView
                                x:Name="HistorySongsListView"
                                Visibility="Collapsed"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnHistorySongItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SongItem">
                                        <Grid Padding="10,8" ColumnSpacing="12" Tag="{x:Bind}" RightTapped="OnSongItemRightTapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind ArtistText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind DurationText}" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>

                    <!-- ==================== 视图 11：本地音乐 (LocalMusicView — 1:1 同步 .worktrees/local-music-folder-tree 列表/文件夹树双视图与多根目录管理) ==================== -->
                    <Grid x:Name="LocalMusicView" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部 Sticky 操作栏：标题、歌曲数量、本地搜索、列表/文件夹视图切换、播放全部、定位当前播放、重新扫描、添加文件夹、文件夹管理 -->
                        <Border Grid.Row="0" Style="{StaticResource FluentSurfaceCardStyle}" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="本地音乐" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="{StaticResource BrandAccentSubtleBrush}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="LocalSongsCountText" Text="0 首歌曲" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <TextBox
                                    x:Name="LocalMusicSearchBox"
                                    Grid.Column="1"
                                    PlaceholderText="搜索本地音乐..."
                                    VerticalAlignment="Center"
                                    TextChanged="OnLocalMusicSearchTextChanged" />

                                <!-- 视图切换：文件夹 vs 列表 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button x:Name="LocalFolderModeBtn" Click="OnLocalViewModeSwitchClick" Tag="folder" Style="{StaticResource BrandPrimaryButtonStyle}" CornerRadius="6" Padding="12,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                            <TextBlock Text="文件夹" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LocalListModeBtn" Click="OnLocalViewModeSwitchClick" Tag="list" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="6" Padding="12,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8FD;" FontSize="12" />
                                            <TextBlock Text="列表" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- 右侧动作按钮组 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Click="OnPlayAllLocalMusicClick" Style="{StaticResource BrandPrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock Text="播放全部" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnLocatePlayingLocalSongClick" ToolTipService.ToolTip="定位当前播放歌曲">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE81D;" FontSize="12" />
                                            <TextBlock Text="定位当前" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnScanLocalMusicClick" ToolTipService.ToolTip="重新扫描全部已配置的本地音乐文件夹">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                            <TextBlock Text="重新扫描" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnAddLocalMusicFolderClick" ToolTipService.ToolTip="添加扫描文件夹">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8F4;" FontSize="12" />
                                            <TextBlock Text="添加文件夹" />
                                        </StackPanel>
                                    </Button>
                                    <Button ToolTipService.ToolTip="文件夹管理（调整扫描文件夹顺序或移除目录）">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE713;" FontSize="12" />
                                            <TextBlock Text="文件夹管理" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedRight">
                                                <StackPanel Width="440" Spacing="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="扫描文件夹管理" FontWeight="SemiBold" FontSize="15" />
                                                            <TextBlock Text="可上移/下移调整根目录显示顺序，或移除不需要扫描的文件夹" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="添加文件夹" Click="OnAddLocalMusicFolderClick" Style="{StaticResource BrandPrimaryButtonStyle}" Padding="10,4" FontSize="12" />
                                                    </Grid>

                                                    <ListView x:Name="ConfiguredLocalFoldersListView" MaxHeight="260" SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Grid Padding="4,6" ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                                    <TextBlock Grid.Column="1" Text="{x:Bind}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind}" />
                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                                        <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnMoveLocalFolderUpClick" ToolTipService.ToolTip="上移">
                                                                            <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                                                        </Button>
                                                                        <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnMoveLocalFolderDownClick" ToolTipService.ToolTip="下移">
                                                                            <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                                                        </Button>
                                                                        <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnRemoveLocalFolderClick" ToolTipService.ToolTip="移除文件夹">
                                                                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 内容区：双视图容器（1. 文件夹层级树双栏视图 / 2. 扁平全量列表视图） -->
                        <Grid Grid.Row="1">
                            <!-- 模式 A：文件夹树分栏视图 (LocalFolderSplitGrid) -->
                            <Grid x:Name="LocalFolderSplitGrid" Visibility="Visible" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧：层级文件夹树面板 -->
                                <Border Grid.Column="0" Style="{StaticResource FluentSurfaceCardStyle}" Padding="10,12">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Padding="6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="文件夹" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="直属曲目数" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>

                                        <ListView
                                            x:Name="FolderTreeListView"
                                            Grid.Row="1"
                                            SelectionMode="Single"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnFolderTreeNodeItemClick">
                                            <ListView.ItemContainerTransitions>
                                                <TransitionCollection>
                                                    <AddDeleteThemeTransition />
                                                    <RepositionThemeTransition />
                                                    <ContentThemeTransition />
                                                </TransitionCollection>
                                            </ListView.ItemContainerTransitions>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:LocalMusicFolderNode">
                                                    <Grid Padding="4,6" Margin="{x:Bind IndentMargin}" ColumnSpacing="6" ToolTipService.ToolTip="{x:Bind Path}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon
                                                            Grid.Column="0"
                                                            Glyph="&#xE76C;"
                                                            FontSize="10"
                                                            Width="16"
                                                            Height="16"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            CenterPoint="8,8,0"
                                                            Rotation="{x:Bind ExpandRotation, Mode=OneWay}"
                                                            Visibility="{x:Bind ExpandIconVisibility, Mode=OneWay}">
                                                            <FontIcon.RotationTransition>
                                                                <ScalarTransition Duration="0:0:0.22" />
                                                            </FontIcon.RotationTransition>
                                                        </FontIcon>
                                                        <FontIcon Grid.Column="1" Glyph="{x:Bind FolderGlyph, Mode=OneWay}" FontSize="15" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind SongCountText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>

                                <!-- 右侧：当前选中文件夹的直属歌曲表（名称 | 声道 | 文件大小 | 歌曲时长 | 操作） -->
                                <Border Grid.Column="1" Style="{StaticResource FluentSurfaceCardStyle}" Padding="14,12">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Padding="6,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock x:Name="SelectedFolderTitleText" Text="选择一个文件夹查看直属歌曲" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="SelectedFolderPathText" Text="" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 表头：名称 | 声道 | 文件大小 | 歌曲时长 | 操作 -->
                                        <Grid Grid.Row="1" Padding="10,6" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="2.5*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="75" />
                                                <ColumnDefinition Width="84" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="歌曲名称 / 歌手 / 专辑" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="声道" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="文件大小" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="4" Text="歌曲时长" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="5" Text="操作" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        </Grid>

                                        <ListView
                                            x:Name="CurrentFolderSongsListView"
                                            Grid.Row="2"
                                            SelectionMode="Single"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnCurrentFolderSongItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:SongItem">
                                                    <Grid Padding="6,6" ColumnSpacing="12" Tag="{x:Bind}" RightTapped="OnSongItemRightTapped">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40" />
                                                            <ColumnDefinition Width="2.5*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="95" />
                                                            <ColumnDefinition Width="75" />
                                                            <ColumnDefinition Width="84" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <Image Source="{x:Bind CoverThumbnailUrl}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{x:Bind ArtistText}" />
                                                                <Run Text=" · " />
                                                                <Run Text="{x:Bind AlbumText}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{StaticResource BrandAccentSubtleBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ChannelText}" FontSize="11" Foreground="{StaticResource BrandAccentBrush}" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Grid.Column="3" Text="{x:Bind FileSizeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{x:Bind DurationText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnOpenLocalSongLocationClick" ToolTipService.ToolTip="打开文件所在位置">
                                                                <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                                            </Button>
                                                            <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnRemoveLocalSongFromListClick" ToolTipService.ToolTip="从本地列表移除（不删除磁盘文件）">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 模式 B：全量列表视图 (LocalSongsListView) -->
                            <Border x:Name="LocalFlatListCard" Visibility="Collapsed" Style="{StaticResource FluentSurfaceCardStyle}" Padding="14,12">
                                <ListView
                                    x:Name="LocalSongsListView"
                                    SelectionMode="Single"
                                    IsItemClickEnabled="True"
                                    ItemClick="OnLocalSongItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SongItem">
                                            <Grid Padding="8,6" ColumnSpacing="12" Tag="{x:Bind}" RightTapped="OnSongItemRightTapped">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="75" />
                                                    <ColumnDefinition Width="84" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind CoverThumbnailUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind ArtistText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind AlbumText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="4" Background="{StaticResource BrandAccentSubtleBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ChannelText}" FontSize="11" Foreground="{StaticResource BrandAccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Grid.Column="5" Text="{x:Bind FileSizeText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{x:Bind DurationText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnOpenLocalSongLocationClick" ToolTipService.ToolTip="打开文件所在位置">
                                                        <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                                    </Button>
                                                    <Button Style="{StaticResource TransportIconButtonStyle}" Tag="{x:Bind}" Click="OnRemoveLocalSongFromListClick" ToolTipService.ToolTip="从本地列表移除">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== 视图 11.5：QQ音乐独立歌单中心 (QqMusicView — 1:1 对应 views/qq-music/index.vue) ==================== -->
                    <Grid x:Name="QqMusicView" Visibility="Collapsed" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部 QQ 音乐账号信息卡片 -->
                        <Border Grid.Row="0" Style="{StaticResource FluentSurfaceCardStyle}" Padding="18,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="28" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Image x:Name="QqPageAvatarImg" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="QqPageNicknameText" Text="QQ 音乐歌单中心" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource BrandAccentSubtleBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                            <TextBlock Text="QQ音乐" FontSize="11" Foreground="{StaticResource BrandAccentBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="QqPageStatusText" Text="登录 QQ 音乐后查看独立创建的歌单与收藏的歌单" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button x:Name="QqPageQuickLoginBtn" Content="调用本机 QQ 登录" Click="OnQqClientQuickLoginClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                    <Button x:Name="QqPageGoLoginBtn" Content="扫码 / 更多登录" Click="OnGoToQqLoginClick" />
                                    <Button Content="刷新歌单" Click="OnRefreshQqPlaylistsClick" />
                                    <Button x:Name="QqPageLogoutBtn" Content="退出 QQ 音乐" Click="OnLogoutQqMusicClick" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 创建的歌单 / 收藏的歌单 分段导航 -->
                        <NavigationView
                            x:Name="QqMusicPlaylistsNavView"
                            Grid.Row="1"
                            PaneDisplayMode="Top"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            ItemInvoked="OnQqMusicPlaylistsNavItemInvoked">
                            <NavigationView.MenuItems>
                                <NavigationViewItem Content="创建的歌单" Tag="Created" IsSelected="True">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xE93C;" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>
                                <NavigationViewItem Content="收藏的歌单" Tag="Collected">
                                    <NavigationViewItem.Icon>
                                        <FontIcon Glyph="&#xEB51;" />
                                    </NavigationViewItem.Icon>
                                </NavigationViewItem>
                            </NavigationView.MenuItems>
                        </NavigationView>

                        <!-- 歌单卡片网格 -->
                        <Grid Grid.Row="2">
                            <GridView
                                x:Name="QqCreatedPlaylistsGrid"
                                Visibility="Visible"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnPlaylistCardClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlaylistItem">
                                        <Border Width="168" Margin="0,0,12,12" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <Border Width="150" Height="150" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind CoverImgUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind TrackCount}" />
                                                    <Run Text=" 首" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>

                            <GridView
                                x:Name="QqCollectedPlaylistsGrid"
                                Visibility="Collapsed"
                                SelectionMode="None"
                                IsItemClickEnabled="True"
                                ItemClick="OnPlaylistCardClick">
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PlaylistItem">
                                        <Border Width="168" Margin="0,0,12,12" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <Border Width="150" Height="150" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <Image Source="{x:Bind CoverImgUrl}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind TrackCount}" />
                                                    <Run Text=" 首" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </Grid>

                    <!-- ==================== 视图 12：下载管理 (DownloadsView — 1:1 还原 DownloadPage.vue 与下载设置抽屉) ==================== -->
                    <Grid x:Name="DownloadsView" Visibility="Collapsed">
                        <Grid RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 1. 顶部 Hero 横幅区域 (对应 DownloadPage.vue hero section) -->
                            <Border
                                Grid.Row="0"
                                Padding="24"
                                CornerRadius="20"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <Grid ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧云下载大图标卡片 -->
                                    <Border
                                        Grid.Column="0"
                                        Width="128"
                                        Height="128"
                                        CornerRadius="24"
                                        Background="#1A10B981"
                                        BorderBrush="#3310B981"
                                        BorderThickness="1">
                                        <FontIcon
                                            Glyph="&#xEBD3;"
                                            FontSize="48"
                                            Foreground="{StaticResource BrandAccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <!-- 右侧标签、主标题与统计副标题 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                        <Border
                                            Background="#2210B981"
                                            CornerRadius="12"
                                            Padding="12,4"
                                            HorizontalAlignment="Left">
                                            <TextBlock
                                                Text="下载管理"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource BrandAccentBrush}" />
                                        </Border>
                                        <TextBlock
                                            x:Name="DownloadHeroTitleText"
                                            Text="已下载"
                                            FontSize="34"
                                            FontWeight="Bold" />
                                        <TextBlock
                                            x:Name="DownloadHeroSubtitleText"
                                            Text="共 0 首歌曲"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. 操作栏：左侧胶囊分段 Tab（下载中 | 已下载）+ 右侧清空记录/打开文件夹/下载设置圆形按钮 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 左侧分段切换胶囊 -->
                                <Border
                                    Grid.Column="0"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="10"
                                    Padding="4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button
                                            x:Name="DownloadTabDownloadingBtn"
                                            Content="下载中"
                                            Tag="downloading"
                                            Click="OnDownloadTabSwitchClick"
                                            Style="{StaticResource SecondaryTabButtonStyle}"
                                            CornerRadius="8"
                                            Padding="20,6"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            FontSize="13"
                                            FontWeight="SemiBold" />
                                        <Button
                                            x:Name="DownloadTabDownloadedBtn"
                                            Content="已下载"
                                            Tag="downloaded"
                                            Click="OnDownloadTabSwitchClick"
                                            Style="{StaticResource SecondaryTabButtonStyle}"
                                            CornerRadius="8"
                                            Padding="20,6"
                                            BorderThickness="0"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            Foreground="{StaticResource BrandAccentBrush}"
                                            FontSize="13"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <!-- 右侧工具按钮组 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button
                                        x:Name="ClearDownloadHistoryBtn"
                                        Visibility="Collapsed"
                                        Click="OnClearDownloadHistoryClick"
                                        CornerRadius="18"
                                        Padding="14,6"
                                        Background="#18EF4444"
                                        BorderBrush="#33EF4444"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                            <TextBlock Text="清空记录" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        Padding="0"
                                        Click="OnOpenDownloadFolderClick"
                                        ToolTipService.ToolTip="打开文件夹">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="15" />
                                    </Button>

                                    <Button
                                        Width="38"
                                        Height="38"
                                        CornerRadius="19"
                                        Padding="0"
                                        Click="OnOpenDownloadSettingsDrawerClick"
                                        ToolTipService.ToolTip="下载设置">
                                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 3. 列表内容区（下载中面板 vs 已下载面板） -->
                            <Grid Grid.Row="2">
                                <!-- 3A. 下载中 Tab 面板 -->
                                <Grid x:Name="DownloadingTabPanel" Visibility="Collapsed">
                                    <!-- 下载中空状态 -->
                                    <StackPanel
                                        x:Name="DownloadingEmptyState"
                                        Visibility="Visible"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                        <FontIcon
                                            Glyph="&#xEBD3;"
                                            FontSize="48"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="暂无下载任务"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 正在下载任务列表 -->
                                    <ListView x:Name="DownloadTasksListView" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:DownloadTaskItem">
                                                <Border
                                                    Style="{StaticResource FluentSettingsCardStyle}"
                                                    Margin="0,0,0,8"
                                                    Padding="16,12"
                                                    CornerRadius="12">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <Image Source="{x:Bind Song.CoverThumbnailUrl}" Stretch="UniformToFill" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                            <!-- 顶行：歌名/歌手 + 状态胶囊 -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{x:Bind Filename, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="-" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{x:Bind Song.ArtistText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <Border Grid.Column="1" Background="#1F10B981" CornerRadius="6" Padding="8,2">
                                                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandAccentBrush}" />
                                                                </Border>
                                                            </Grid>

                                                            <!-- 中行：进度条 -->
                                                            <ProgressBar
                                                                Value="{x:Bind Progress, Mode=OneWay}"
                                                                Maximum="100"
                                                                Height="6"
                                                                Foreground="{StaticResource BrandAccentBrush}" />

                                                            <!-- 底行：已下载大小/总大小 + 暂停/恢复/取消按钮 + 百分比 -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    Grid.Column="0"
                                                                    Text="{x:Bind SizeProgressText, Mode=OneWay}"
                                                                    FontSize="11"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <Button
                                                                        Visibility="{x:Bind PauseVisibility, Mode=OneWay}"
                                                                        Tag="{x:Bind TaskId}"
                                                                        Click="OnPauseDownloadTaskClick"
                                                                        Padding="6,4"
                                                                        ToolTipService.ToolTip="暂停下载">
                                                                        <FontIcon Glyph="&#xE769;" FontSize="12" />
                                                                    </Button>
                                                                    <Button
                                                                        Visibility="{x:Bind ResumeVisibility, Mode=OneWay}"
                                                                        Tag="{x:Bind TaskId}"
                                                                        Click="OnResumeDownloadTaskClick"
                                                                        Padding="6,4"
                                                                        ToolTipService.ToolTip="恢复下载">
                                                                        <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" />
                                                                    </Button>
                                                                    <Button
                                                                        Visibility="{x:Bind CancelVisibility, Mode=OneWay}"
                                                                        Tag="{x:Bind TaskId}"
                                                                        Click="OnCancelDownloadTaskClick"
                                                                        Padding="6,4"
                                                                        ToolTipService.ToolTip="取消下载">
                                                                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#EF4444" />
                                                                    </Button>
                                                                    <TextBlock
                                                                        Text="{x:Bind ProgressText, Mode=OneWay}"
                                                                        Width="46"
                                                                        TextAlignment="Right"
                                                                        FontSize="12"
                                                                        FontWeight="SemiBold"
                                                                        VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>

                                <!-- 3B. 已下载 Tab 面板 -->
                                <Grid x:Name="DownloadedTabPanel" Visibility="Visible">
                                    <!-- 已下载空状态 -->
                                    <StackPanel
                                        x:Name="DownloadedEmptyState"
                                        Visibility="Visible"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <FontIcon
                                            Glyph="&#xE7B8;"
                                            FontSize="48"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="暂无已下载歌曲"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="去下载你喜欢的歌曲吧"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 已下载歌曲列表 -->
                                    <ListView x:Name="CompletedDownloadsListView" SelectionMode="None">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:CompletedDownloadItem">
                                                <Border
                                                    Style="{StaticResource FluentSettingsCardStyle}"
                                                    Margin="0,0,0,8"
                                                    Padding="14,10"
                                                    CornerRadius="12">
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 封面与播放按钮叠加层 -->
                                                        <Button
                                                            Grid.Column="0"
                                                            Width="48"
                                                            Height="48"
                                                            CornerRadius="10"
                                                            Style="{StaticResource CoverOverlayButtonStyle}"
                                                            Tag="{x:Bind}"
                                                            Click="OnPlayCompletedDownloadClick"
                                                            ToolTipService.ToolTip="点击播放">
                                                            <Grid Width="48" Height="48">
                                                                <Image Source="{x:Bind CoverThumbnailUrl}" Stretch="UniformToFill" />
                                                                <Border Background="#55000000" CornerRadius="10">
                                                                    <FontIcon Glyph="&#xE768;" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>

                                                        <!-- 歌曲名、文件大小、歌手与缩写路径胶囊 -->
                                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind FileSizeText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBlock Text="{x:Bind ArtistText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <FontIcon Glyph="&#xE8B7;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        <TextBlock Text="{x:Bind ShortenedPath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <!-- 右侧操作按钮组：复制路径、打开文件夹、删除 -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button
                                                                Tag="{x:Bind}"
                                                                Click="OnCopyCompletedPathClick"
                                                                Width="34"
                                                                Height="34"
                                                                Padding="0"
                                                                CornerRadius="8"
                                                                ToolTipService.ToolTip="复制路径">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                            </Button>
                                                            <Button
                                                                Tag="{x:Bind}"
                                                                Click="OnOpenCompletedItemFolderClick"
                                                                Width="34"
                                                                Height="34"
                                                                Padding="0"
                                                                CornerRadius="8"
                                                                ToolTipService.ToolTip="打开文件夹">
                                                                <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                                            </Button>
                                                            <Button
                                                                Tag="{x:Bind}"
                                                                Click="OnDeleteCompletedDownloadClick"
                                                                Width="34"
                                                                Height="34"
                                                                Padding="0"
                                                                CornerRadius="8"
                                                                ToolTipService.ToolTip="删除">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- 4. 右侧滑出“下载设置”抽屉 (1:1 对齐 DownloadPage.vue n-drawer width=400) -->
                        <Grid x:Name="DownloadSettingsDrawerOverlay" Visibility="Collapsed" Margin="-28,-18,-24,-12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧半透明遮罩层（点击遮罩关闭抽屉） -->
                            <Border
                                x:Name="DownloadSettingsBackdrop"
                                Grid.Column="0"
                                Background="#44000000"
                                Tapped="OnDownloadSettingsBackdropTapped" />

                            <!-- 右侧 400px 抽屉主体 -->
                            <Border
                                x:Name="DownloadSettingsDrawerPanel"
                                Grid.Column="1"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0"
                                Padding="22,18">
                                <Grid RowSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 抽屉标题栏 -->
                                    <Grid Grid.Row="0" Padding="0,0,0,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="下载设置" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Width="30"
                                            Height="30"
                                            Padding="0"
                                            CornerRadius="6"
                                            Click="OnCloseDownloadSettingsDrawerClick">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <!-- 抽屉表单内容滚动区 -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="22" Padding="0,4,6,12">
                                            <!-- 4.1 下载位置 -->
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="下载位置" FontSize="15" FontWeight="Bold" />
                                                <TextBlock Text="设置音乐文件下载保存的位置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox x:Name="DownloadDrawerPathBox" IsReadOnly="True" PlaceholderText="选择下载保存文件夹" />
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" HorizontalAlignment="Stretch" Content="选择文件夹" Click="OnPickDownloadFolderFromDrawerClick" />
                                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Content="打开文件夹" Click="OnOpenDownloadFolderFromDrawerClick" />
                                                </Grid>
                                            </StackPanel>

                                            <!-- 4.2 单独保存歌词文件 -->
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="单独保存歌词文件" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock Text="下载歌曲时同时保存一份 .lrc 歌词文件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="DownloadDrawerSaveLyricToggle"
                                                    Grid.Column="1"
                                                    OffContent=""
                                                    OnContent=""
                                                    MinWidth="44"
                                                    VerticalAlignment="Center"
                                                    Toggled="OnDownloadDrawerSettingModified" />
                                            </Grid>

                                            <!-- 4.3 最大并发数 (1-5) -->
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="最大并发数" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock Text="同时下载的最大歌曲数量 (1-5)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <NumberBox
                                                    x:Name="DownloadDrawerConcurrentBox"
                                                    Grid.Column="1"
                                                    Width="118"
                                                    Minimum="1"
                                                    Maximum="5"
                                                    Value="3"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    VerticalAlignment="Center"
                                                    ValueChanged="OnDownloadDrawerConcurrentChanged" />
                                            </Grid>

                                            <!-- 4.4 文件名格式 -->
                                            <StackPanel Spacing="12">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="文件名格式" FontSize="15" FontWeight="Bold" />
                                                    <TextBlock Text="设置下载音乐时的文件命名格式" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- 3 个预设按钮 -->
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button
                                                        x:Name="DownloadFormatPreset0Btn"
                                                        Content="歌曲名 - 歌手名"
                                                        Tag="song_artist"
                                                        Click="OnDownloadFormatPresetClick"
                                                        Padding="10,6"
                                                        FontSize="12" />
                                                    <Button
                                                        x:Name="DownloadFormatPreset1Btn"
                                                        Content="歌手名 - 歌曲名"
                                                        Tag="artist_song"
                                                        Click="OnDownloadFormatPresetClick"
                                                        Padding="10,6"
                                                        FontSize="12" />
                                                    <Button
                                                        x:Name="DownloadFormatPreset2Btn"
                                                        Content="仅歌曲名"
                                                        Tag="song_only"
                                                        Click="OnDownloadFormatPresetClick"
                                                        Padding="10,6"
                                                        FontSize="12" />
                                                </StackPanel>

                                                <!-- 分隔符选择与自定义输入 -->
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="分隔符" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button
                                                            x:Name="DownloadSepDashBtn"
                                                            Content="-"
                                                            Tag=" - "
                                                            Click="OnDownloadSeparatorQuickClick"
                                                            MinWidth="34"
                                                            Padding="8,5"
                                                            FontSize="12" />
                                                        <Button
                                                            x:Name="DownloadSepUnderscoreBtn"
                                                            Content="_"
                                                            Tag="_"
                                                            Click="OnDownloadSeparatorQuickClick"
                                                            MinWidth="34"
                                                            Padding="8,5"
                                                            FontSize="12" />
                                                        <Button
                                                            x:Name="DownloadSepSpaceBtn"
                                                            Content="Space"
                                                            Tag=" "
                                                            Click="OnDownloadSeparatorQuickClick"
                                                            Padding="10,5"
                                                            FontSize="12" />
                                                        <TextBox
                                                            x:Name="DownloadSeparatorCustomBox"
                                                            Width="156"
                                                            Text=" - "
                                                            PlaceholderText="自定义分隔符"
                                                            TextChanged="OnDownloadSeparatorCustomTextChanged" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 组件顺序调整与添加 -->
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="拖动排序或使用箭头按钮调整顺序：" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <ItemsControl x:Name="DownloadFormatComponentsList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DownloadFormatComponentItem">
                                                                <Border
                                                                    CornerRadius="8"
                                                                    Padding="12,8"
                                                                    Margin="0,0,0,6"
                                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}" FontSize="13" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                            <Button
                                                                                IsEnabled="{x:Bind CanMoveUp}"
                                                                                Tag="{x:Bind Index}"
                                                                                Click="OnMoveFormatComponentUpClick"
                                                                                Width="26"
                                                                                Height="26"
                                                                                Padding="0"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                ToolTipService.ToolTip="上移">
                                                                                <FontIcon Glyph="&#xE70E;" FontSize="10" />
                                                                            </Button>
                                                                            <Button
                                                                                IsEnabled="{x:Bind CanMoveDown}"
                                                                                Tag="{x:Bind Index}"
                                                                                Click="OnMoveFormatComponentDownClick"
                                                                                Width="26"
                                                                                Height="26"
                                                                                Padding="0"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                ToolTipService.ToolTip="下移">
                                                                                <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                                            </Button>
                                                                            <Button
                                                                                IsEnabled="{x:Bind CanRemove}"
                                                                                Tag="{x:Bind Type}"
                                                                                Click="OnRemoveFormatComponentClick"
                                                                                Width="26"
                                                                                Height="26"
                                                                                Padding="0"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                ToolTipService.ToolTip="移除">
                                                                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- 添加格式字段按钮 -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button
                                                            x:Name="AddFormatSongNameBtn"
                                                            Content="+ 歌曲名"
                                                            Tag="songName"
                                                            Click="OnAddFormatComponentClick"
                                                            Padding="10,4"
                                                            FontSize="12" />
                                                        <Button
                                                            x:Name="AddFormatArtistNameBtn"
                                                            Content="+ 歌手名"
                                                            Tag="artistName"
                                                            Click="OnAddFormatComponentClick"
                                                            Padding="10,4"
                                                            FontSize="12" />
                                                        <Button
                                                            x:Name="AddFormatAlbumNameBtn"
                                                            Content="+ 专辑名"
                                                            Tag="albumName"
                                                            Click="OnAddFormatComponentClick"
                                                            Padding="10,4"
                                                            FontSize="12" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- 预览效果框 -->
                                                <Border
                                                    CornerRadius="10"
                                                    Padding="14,12"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="预览效果：" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock
                                                            x:Name="DownloadFormatPreviewText"
                                                            Text="莫失莫忘 - 香蜜沉沉烬如霜"
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource BrandAccentBrush}"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- 抽屉底部保存按钮 -->
                                    <Border Grid.Row="2" Padding="0,10,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <Button
                                            Content="保存"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource BrandPrimaryButtonStyle}"
                                            FontWeight="SemiBold"
                                            Padding="0,8"
                                            CornerRadius="8"
                                            Click="OnSaveDownloadSettingsDrawerClick" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== 视图 13：个人中心与 4 合 1 登录 (UserView — 使用 WinUI 3 SelectorBar) ==================== -->
                    <ScrollViewer x:Name="UserView" Visibility="Collapsed">
                        <StackPanel Spacing="18" Padding="0,0,10,28">
                            <StackPanel Spacing="2">
                                <TextBlock Text="个人中心与多方式登录" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock x:Name="UserLoginStatusText" Text="未登录（支持扫码、UID 免密登录、Cookie 登录或歌单导入）" FontSize="13" Foreground="{StaticResource BrandAccentBrush}" />
                            </StackPanel>

                            <!-- 双平台（网易云音乐 | QQ音乐）登录与外部歌单导入卡片 -->
                            <Border Style="{StaticResource FluentSurfaceCardStyle}">
                                <StackPanel Spacing="12">
                                    <!-- 顶部平台切换器：网易云 vs QQ音乐（对应 views/login/index.vue） -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="LoginProviderNeteaseBtn" Click="OnLoginProviderSwitchClick" Tag="netease" Style="{StaticResource BrandPrimaryButtonStyle}" CornerRadius="6" Padding="16,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xEC4F;" FontSize="13" />
                                                    <TextBlock Text="网易云音乐" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="LoginProviderQqBtn" Click="OnLoginProviderSwitchClick" Tag="qq" Style="{StaticResource SecondaryTabButtonStyle}" CornerRadius="6" Padding="16,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8D6;" FontSize="13" />
                                                    <TextBlock Text="QQ 音乐" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                            <Button Content="打开独立 QQ 音乐歌单中心 →" Tag="QqMusic" Click="OnNavButtonClick" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="NeteaseInlineLogoutBtn" Content="退出网易云登录" Click="OnLogoutClick" Visibility="Collapsed" />
                                            <Button x:Name="QqInlineLogoutBtn" Content="退出 QQ 登录" Click="OnLogoutQqMusicClick" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 平台 1：网易云 4 合 1 登录面板 -->
                                    <StackPanel x:Name="NeteaseLoginProviderPanel" Spacing="12">
                                        <NavigationView
                                            x:Name="LoginMethodNavView"
                                            PaneDisplayMode="Top"
                                            IsBackButtonVisible="Collapsed"
                                            IsSettingsVisible="False"
                                            ItemInvoked="OnLoginMethodNavViewItemInvoked">
                                            <NavigationView.MenuItems>
                                                <NavigationViewItem Content="扫码登录" Tag="Qr" IsSelected="True">
                                                    <NavigationViewItem.Icon>
                                                        <FontIcon Glyph="&#xED14;" />
                                                    </NavigationViewItem.Icon>
                                                </NavigationViewItem>
                                                <NavigationViewItem Content="UID 免密登录" Tag="Uid">
                                                    <NavigationViewItem.Icon>
                                                        <FontIcon Glyph="&#xE77B;" />
                                                    </NavigationViewItem.Icon>
                                                </NavigationViewItem>
                                                <NavigationViewItem Content="Cookie 登录" Tag="Cookie">
                                                    <NavigationViewItem.Icon>
                                                        <FontIcon Glyph="&#xE8D7;" />
                                                    </NavigationViewItem.Icon>
                                                </NavigationViewItem>
                                                <NavigationViewItem Content="外部歌单导入" Tag="Import">
                                                    <NavigationViewItem.Icon>
                                                        <FontIcon Glyph="&#xE896;" />
                                                    </NavigationViewItem.Icon>
                                                </NavigationViewItem>
                                            </NavigationView.MenuItems>
                                        </NavigationView>

                                        <StackPanel x:Name="LoginQrPanel" Orientation="Horizontal" Spacing="20" Padding="8">
                                            <Border Width="144" Height="144" CornerRadius="8" Background="White" Padding="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Image x:Name="LoginQrImage" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="10">
                                                <TextBlock Text="使用网易云音乐 App 扫码授权登录" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="扫码成功后将自动保存登录态并同步创建的歌单、收藏专辑与听歌排行。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button Content="生成 / 刷新登录二维码" Click="OnGenerateQrLoginClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="LoginUidPanel" Visibility="Collapsed" Spacing="10" Padding="8" MaxWidth="520" HorizontalAlignment="Left">
                                            <TextBlock Text="无需密码或手机验证：输入任意网易云用户 UID 即可同步其公开歌单与听歌排行" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBox x:Name="UidLoginInputBox" Width="280" PlaceholderText="输入网易云数字 UID (例如 32953014)..." />
                                                <Button Content="UID 免密登录" Click="OnUidLoginClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel x:Name="LoginCookiePanel" Visibility="Collapsed" Spacing="10" Padding="8">
                                            <TextBox
                                                x:Name="CookieInputBox"
                                                PlaceholderText="粘贴包含 MUSIC_U=... 的网易云 Cookie 字符串"
                                                AcceptsReturn="True"
                                                Height="72"
                                                TextWrapping="Wrap" />
                                            <Button Content="保存 Cookie 并同步" Click="OnSaveCookieLoginClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                        </StackPanel>

                                        <StackPanel x:Name="LoginImportPanel" Visibility="Collapsed" Spacing="10" Padding="8" MaxWidth="560" HorizontalAlignment="Left">
                                            <TextBlock Text="支持输入网易云歌单 ID 或粘贴完整歌单分享链接直接打开" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBox x:Name="ImportPlaylistInputBox" Width="360" PlaceholderText="输入歌单 ID 或 https://music.163.com/playlist?id=..." />
                                                <Button Content="导入并打开歌单" Click="OnImportPlaylistClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 平台 2：QQ 音乐 3 合 1 登录面板（本机 QQ 快捷登录 / 手动账号密码登录 / 手机 QQ 扫码登录） -->
                                    <StackPanel x:Name="QqLoginProviderPanel" Visibility="Collapsed" Spacing="12">
                                        <NavigationView
                                            x:Name="QqLoginMethodNavView"
                                            PaneDisplayMode="Top"
                                            IsBackButtonVisible="Collapsed"
                                            IsSettingsVisible="False"
                                            ItemInvoked="OnQqLoginMethodNavViewItemInvoked">
                                            <NavigationView.MenuItems>
                                                <NavigationViewItem Content="QQ 快捷登录" Tag="Local" IsSelected="True">
                                                    <NavigationViewItem.Icon>
                                                        <FontIcon Glyph="&#xE77B;" />
                                                    </NavigationViewItem.Icon>
                                                </NavigationViewItem>
                                                <NavigationViewItem Content="账号密码登录" Tag="Password">
                                                    <NavigationViewItem.Icon>
                                                        <FontIcon Glyph="&#xE8D7;" />
                                                    </NavigationViewItem.Icon>
                                                </NavigationViewItem>
                                                <NavigationViewItem Content="QQ 扫码登录" Tag="Qr">
                                                    <NavigationViewItem.Icon>
                                                        <FontIcon Glyph="&#xED14;" />
                                                    </NavigationViewItem.Icon>
                                                </NavigationViewItem>
                                            </NavigationView.MenuItems>
                                        </NavigationView>

                                        <!-- 方式 1：本机已登录 PC QQ 客户端直连快捷登录区 -->
                                        <Border
                                            x:Name="QqLoginLocalSubPanel"
                                            Padding="16,14"
                                            CornerRadius="12"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="本机已登录 QQ 快捷登录" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Content="刷新列表" Click="OnDetectLocalQqAccountsClick" />
                                                        <Button x:Name="PanelConfirmLocalQqLoginBtn" Content="登录选中 QQ" Click="OnConfirmSelectedLocalQqLoginClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                                        <Button Content="打开 QQ 登录器" Click="OnQqClientQuickLoginClick" />
                                                    </StackPanel>
                                                </Grid>

                                                <GridView
                                                    x:Name="LocalQqAccountsGridView"
                                                    ItemsSource="{x:Bind ViewModel.LocalQqAccounts}"
                                                    SelectionMode="None"
                                                    IsItemClickEnabled="True"
                                                    ItemClick="OnLocalQqAccountItemSelectClick"
                                                    Visibility="Collapsed">
                                                    <GridView.ItemTemplate>
                                                        <DataTemplate x:DataType="models:LocalQqAccountItem">
                                                            <Border
                                                                Width="248"
                                                                Padding="12,10"
                                                                Margin="0,0,10,6"
                                                                CornerRadius="10"
                                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                                        <Image Source="{x:Bind AvatarUrl}" Stretch="UniformToFill" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                        <TextBlock Text="{x:Bind DisplayNickname}" FontSize="13" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind DisplayUin}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" />
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                                                        <Border
                                                                            Visibility="{x:Bind SelectedBadgeVisibility, Mode=OneWay}"
                                                                            Background="{StaticResource BrandAccentBrush}"
                                                                            CornerRadius="6"
                                                                            Padding="8,4">
                                                                            <TextBlock Text="✓ 已选择" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                                        </Border>
                                                                        <Border
                                                                            Visibility="{x:Bind UnselectedBadgeVisibility, Mode=OneWay}"
                                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                            CornerRadius="6"
                                                                            Padding="8,4">
                                                                            <TextBlock Text="点击选择" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </GridView.ItemTemplate>
                                                </GridView>
                                            </StackPanel>
                                        </Border>

                                        <!-- 方式 2：手动输入 QQ 账号与密码登录 -->
                                        <StackPanel
                                            x:Name="QqLoginPasswordSubPanel"
                                            Visibility="Collapsed"
                                            Spacing="10"
                                            Padding="8"
                                            MaxWidth="420"
                                            HorizontalAlignment="Left">
                                            <TextBox
                                                x:Name="QqManualUinInputBox"
                                                Width="360"
                                                PlaceholderText="请输入 QQ 号码 / 邮箱账号..."
                                                KeyDown="OnQqManualPasswordInputKeyDown" />
                                            <PasswordBox
                                                x:Name="QqManualPasswordInputBox"
                                                Width="360"
                                                PlaceholderText="请输入 QQ 密码..."
                                                KeyDown="OnQqManualPasswordInputKeyDown" />
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Button
                                                    x:Name="SubmitQqManualPasswordLoginBtn"
                                                    Content="登录 QQ 音乐"
                                                    MinWidth="140"
                                                    Click="OnSubmitQqManualPasswordLoginClick"
                                                    Style="{StaticResource BrandPrimaryButtonStyle}" />
                                                <Button
                                                    Content="在登录器内输入账密"
                                                    Click="OnOpenQqPasswordLauncherClick" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 方式 3：手机 QQ 扫码登录 -->
                                        <StackPanel
                                            x:Name="QqLoginQrSubPanel"
                                            Visibility="Collapsed"
                                            Orientation="Horizontal"
                                            Spacing="18"
                                            Padding="8">
                                            <Border Width="148" Height="148" CornerRadius="8" Background="White" Padding="6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                <Image x:Name="QqLoginQrImage" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="10" MaxWidth="340">
                                                <TextBlock Text="手机 QQ 扫码登录" FontSize="15" FontWeight="SemiBold" />
                                                <Button Content="生成 / 刷新手机 QQ 二维码" Click="OnGenerateQqQrLoginClick" Style="{StaticResource BrandPrimaryButtonStyle}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 原版双栏个人中心：左栏（歌单与收藏专辑） + 右栏（听歌排行） -->
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource FluentSurfaceCardStyle}">
                                    <StackPanel Spacing="12">
                                        <NavigationView
                                            x:Name="UserLibraryNavView"
                                            PaneDisplayMode="Top"
                                            IsBackButtonVisible="Collapsed"
                                            IsSettingsVisible="False"
                                            ItemInvoked="OnUserLibraryNavViewItemInvoked">
                                            <NavigationView.MenuItems>
                                                <NavigationViewItem Content="创建的歌单" Tag="Created" IsSelected="True" />
                                                <NavigationViewItem Content="收藏的歌单" Tag="Fav" />
                                                <NavigationViewItem Content="收藏的专辑" Tag="Album" />
                                            </NavigationView.MenuItems>
                                        </NavigationView>

                                        <GridView
                                            x:Name="UserCreatedPlaylistsGrid"
                                            Visibility="Visible"
                                            SelectionMode="None"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnPlaylistCardClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlaylistItem">
                                                    <StackPanel Width="136" Margin="0,0,10,10" Spacing="5">
                                                        <Border Width="136" Height="136" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <Image Source="{x:Bind CoverImgUrl}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>

                                        <GridView
                                            x:Name="UserFavoritePlaylistsGrid"
                                            Visibility="Collapsed"
                                            SelectionMode="None"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnPlaylistCardClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlaylistItem">
                                                    <StackPanel Width="136" Margin="0,0,10,10" Spacing="5">
                                                        <Border Width="136" Height="136" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <Image Source="{x:Bind CoverImgUrl}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>

                                        <GridView
                                            x:Name="UserSubscribedAlbumsGrid"
                                            Visibility="Collapsed"
                                            SelectionMode="None"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnAlbumCardClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="models:AlbumItem">
                                                    <StackPanel Width="136" Margin="0,0,10,10" Spacing="5">
                                                        <Border Width="136" Height="136" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <Image Source="{x:Bind PicUrl}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Name}" MaxLines="1" TextTrimming="CharacterEllipsis" FontSize="12" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                    </StackPanel>
                                </Border>

                                <!-- 右栏：听歌排行 -->
                                <Border Grid.Column="1" Style="{StaticResource FluentSurfaceCardStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="16" Foreground="{StaticResource BrandAccentBrush}" />
                                                <TextBlock Text="听歌排行" FontSize="16" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Button Content="最近一周" Tag="1" Click="OnUserPlayRecordTypeClick" Padding="8,4" FontSize="12" />
                                                <Button Content="所有时间" Tag="0" Click="OnUserPlayRecordTypeClick" Padding="8,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <ListView
                                            x:Name="UserPlayRecordListView"
                                            MaxHeight="420"
                                            SelectionMode="None"
                                            IsItemClickEnabled="True"
                                            ItemClick="OnUserPlayRecordItemClick">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:PlayRecordItem">
                                                    <Grid Padding="4,6" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{x:Bind Song.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Song.ArtistText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{StaticResource BrandAccentSubtleBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind PlayCountText}" FontSize="11" Foreground="{StaticResource BrandAccentBrush}" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== 视图 14：系统设置 (SettingsView — 1:1 还原 views/set/index.vue + 7 大 Tab + 6 大原版弹窗) ==================== -->
                    <Grid x:Name="SettingsView" Visibility="Collapsed" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 顶部导航区 (1:1 对齐 views/set/index.vue: 左对齐大标题 "设置" + 圆角胶囊标签页) -->
                        <Border
                            Grid.Row="0"
                            Padding="4,8,4,14"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <StackPanel Spacing="16" HorizontalAlignment="Left">
                                <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            x:Name="SettingsTabBasicBtn"
                                            Content="基础设置"
                                            Tag="Basic"
                                            Click="OnSettingsPillTabClick"
                                            Style="{StaticResource BrandPrimaryButtonStyle}"
                                            CornerRadius="18"
                                            Padding="16,7"
                                            FontSize="13"
                                            FontWeight="SemiBold" />
                                        <Button
                                            x:Name="SettingsTabPlaybackBtn"
                                            Content="播放设置"
                                            Tag="Playback"
                                            Click="OnSettingsPillTabClick"
                                            Style="{StaticResource SecondaryTabButtonStyle}"
                                            CornerRadius="18"
                                            Padding="16,7"
                                            FontSize="13"
                                            FontWeight="Medium" />
                                        <Button
                                            x:Name="SettingsTabApplicationBtn"
                                            Content="应用设置"
                                            Tag="Application"
                                            Click="OnSettingsPillTabClick"
                                            Style="{StaticResource SecondaryTabButtonStyle}"
                                            CornerRadius="18"
                                            Padding="16,7"
                                            FontSize="13"
                                            FontWeight="Medium" />
                                        <Button
                                            x:Name="SettingsTabNetworkBtn"
                                            Content="网络设置"
                                            Tag="Network"
                                            Click="OnSettingsPillTabClick"
                                            Style="{StaticResource SecondaryTabButtonStyle}"
                                            CornerRadius="18"
                                            Padding="16,7"
                                            FontSize="13"
                                            FontWeight="Medium" />
                                        <Button
                                            x:Name="SettingsTabSystemBtn"
                                            Content="系统管理"
                                            Tag="System"
                                            Click="OnSettingsPillTabClick"
                                            Style="{StaticResource SecondaryTabButtonStyle}"
                                            CornerRadius="18"
                                            Padding="16,7"
                                            FontSize="13"
                                            FontWeight="Medium" />
                                        <Button
                                            x:Name="SettingsTabAboutBtn"
                                            Content="关于"
                                            Tag="About"
                                            Click="OnSettingsPillTabClick"
                                            Style="{StaticResource SecondaryTabButtonStyle}"
                                            CornerRadius="18"
                                            Padding="16,7"
                                            FontSize="13"
                                            FontWeight="Medium" />
                                    </StackPanel>
                                </ScrollViewer>
                                <NavigationView x:Name="SettingsNavView" Visibility="Collapsed" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" ItemInvoked="OnSettingsNavViewItemInvoked" />
                            </StackPanel>
                        </Border>

                        <!-- 内容区域 (1:1 对齐 views/set/index.vue: w-full 全宽左对齐，无 MaxWidth 居中偏移) -->
                        <ScrollViewer Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Grid Padding="4,20,16,64" HorizontalAlignment="Stretch">

                                <!-- ==================== Tab 1：基础设置 (1:1 还原 BasicTab.vue) ==================== -->
                                <StackPanel x:Name="SettingsBasicPanel" Visibility="Visible" HorizontalAlignment="Stretch">
                                    <TextBlock Text="基础设置" Style="{StaticResource SettingsGroupHeaderTextStyle}" />

                                    <Border Style="{StaticResource SettingSectionCardStyle}">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <!-- 1.1 主题模式 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="主题模式" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="切换日间/夜间主题" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <ToggleSwitch x:Name="AutoThemeToggle" MinWidth="0" OffContent="" OnContent="" Toggled="OnAutoThemeToggled" />
                                                            <TextBlock x:Name="AutoThemeModeLabel" Text="手动切换" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Button x:Name="ManualThemeToggleBtn" Click="OnToggleThemeClick" CornerRadius="14" Padding="12,5">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon x:Name="ManualThemeToggleIcon" Glyph="&#xE708;" FontSize="13" />
                                                                <TextBlock x:Name="ManualThemeToggleText" Text="夜间" FontSize="12" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 1.2 语言设置 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="语言设置" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="切换显示语言" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="OnLanguageSelectionChanged">
                                                        <ComboBoxItem Content="简体中文" Tag="zh-CN" IsSelected="True" />
                                                        <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                                                        <ComboBoxItem Content="English" Tag="en-US" />
                                                        <ComboBoxItem Content="日本語" Tag="ja-JP" />
                                                        <ComboBoxItem Content="한국어" Tag="ko-KR" />
                                                    </ComboBox>
                                                </Grid>
                                            </Border>

                                            <!-- 1.3 歌詞翻譯引擎 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="歌詞翻譯引擎" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="歌詞翻譯引擎" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="TranslationEngineComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="OnTranslationEngineChanged">
                                                        <ComboBoxItem Content="关闭" Tag="none" IsSelected="True" />
                                                        <ComboBoxItem Content="OpenCC 繁化" Tag="opencc" />
                                                    </ComboBox>
                                                </Grid>
                                            </Border>

                                            <!-- 1.4 字体设置 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="字体设置" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="选择字体，优先使用排在前面的字体" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <ComboBox x:Name="FontScopeComboBox" Width="110" SelectionChanged="OnFontScopeChanged">
                                                            <ComboBoxItem Content="全局" Tag="global" IsSelected="True" />
                                                            <ComboBoxItem Content="仅歌词" Tag="lyric" />
                                                        </ComboBox>
                                                        <ComboBox x:Name="SystemFontComboBox" Width="260" PlaceholderText="选择字体" SelectionChanged="OnSystemFontSelectionChanged">
                                                            <ComboBoxItem Content="默认系统字体 (system-ui)" Tag="Microsoft YaHei UI" IsSelected="True" />
                                                            <ComboBoxItem Content="Microsoft YaHei UI (微软雅黑)" Tag="Microsoft YaHei UI" />
                                                            <ComboBoxItem Content="Segoe UI Variable" Tag="Segoe UI" />
                                                            <ComboBoxItem Content="SimSun (宋体)" Tag="SimSun" />
                                                            <ComboBoxItem Content="KaiTi (楷体)" Tag="KaiTi" />
                                                            <ComboBoxItem Content="FangSong (仿宋)" Tag="FangSong" />
                                                            <ComboBoxItem Content="Consolas (等宽)" Tag="Consolas" />
                                                            <ComboBoxItem Content="DengXian (等线)" Tag="DengXian" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 1.4b 字体预览 (1:1 对齐 BasicTab.vue lines 87-106) -->
                                            <Border x:Name="FontPreviewSectionBorder" Style="{StaticResource SettingItemRowStyle}" Visibility="Visible">
                                                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                                                    <TextBlock Text="字体预览" FontSize="15" FontWeight="Bold" />
                                                    <StackPanel x:Name="FontPreviewPanel" Spacing="10" HorizontalAlignment="Stretch">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="中文" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                                                <TextBlock x:Name="FontPreviewZh" Text="静夜思 床前明月光 疑是地上霜" FontSize="16" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="ENGLISH" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                                                <TextBlock x:Name="FontPreviewEn" Text="The quick brown fox jumps over the lazy dog" FontSize="16" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="日本語" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                                                <TextBlock x:Name="FontPreviewJa" Text="あいうえお かきくけこ さしすせそ" FontSize="16" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="한국어" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="12,10">
                                                                <TextBlock x:Name="FontPreviewKo" Text="가나다라마 바사아자차 카타파하" FontSize="16" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 1.5 Cookie管理 (1:1 对齐 BasicTab.vue lines 108-128) -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="Cookie管理" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock x:Name="BasicTokenStatusText" Text="当前Cookie状态: 未设置" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock x:Name="BasicTokenPreviewText" Text="" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button x:Name="OpenCookieModalBtn" Content="设置Cookie" Click="OnOpenCookieSettingsModalClick" CornerRadius="8" Padding="14,6" />
                                                        <Button x:Name="ClearCookieBtn" Content="清除Cookie" Click="OnLogoutClick" Style="{StaticResource DangerOutlineButtonStyle}" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 1.6 动画速度 (1:1 对齐 BasicTab.vue lines 130-166：开关在左侧描述区，滑块在右侧！) -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                                                        <TextBlock Text="动画速度" FontSize="15" FontWeight="Medium" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <ToggleSwitch x:Name="NoAnimateToggle" MinWidth="0" OffContent="" OnContent="" Toggled="OnNoAnimateToggled" />
                                                            <TextBlock x:Name="NoAnimateStateLabel" Text="开启" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="是否开启动画" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
