<Window
    x:Class="AlgerMusicPlayer.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AlgerMusicPlayer.WinUI.Models"
    Title="Alger Music Player">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" RequestedTheme="Dark">
        <FlyoutBase.AttachedFlyout>
            <!-- 1:1 还原 SongItemDropdown.vue 全局歌曲右键菜单 -->
            <Flyout x:Name="SongContextMenuFlyout" Placement="BottomEdgeAlignedLeft">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="6" />
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="MinWidth" Value="240" />
                        <Setter Property="MaxWidth" Value="260" />
                        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel Spacing="2" Width="236">
                    <!-- 顶部歌曲封面与信息预览 (renderSongPreview) -->
                    <Grid Padding="8,6" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image x:Name="ContextMenuSongCover" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ContextMenuSongTitle" FontSize="13" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ContextMenuSongArtist" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Margin="4,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- 立即播放 -->
                    <Button Click="OnContextMenuPlayClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Width="18" />
                            <TextBlock Text="立即播放" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 下一首播放 -->
                    <Button Click="OnContextMenuPlayNextClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE893;" FontSize="14" Width="18" />
                            <TextBlock Text="下一首播放" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 打开歌曲位置 (仅本地音乐显示) -->
                    <Button x:Name="ContextMenuLocateLocalBtn" Click="OnContextMenuLocateLocalClick" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE838;" FontSize="14" Width="18" />
                            <TextBlock Text="打开歌曲位置" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <Border Height="1" Margin="4,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- 下载歌曲 -->
                    <Button Click="OnContextMenuDownloadSongClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="14" Width="18" />
                            <TextBlock Text="下载歌曲" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 下载歌词 -->
                    <Button Click="OnContextMenuDownloadLyricClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" Width="18" />
                            <TextBlock Text="下载歌词" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 添加到网易云歌单 -->
                    <Button Click="OnContextMenuAddToNeteasePlaylistClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F4;" FontSize="14" Width="18" />
                            <TextBlock Text="添加到网易云歌单" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 添加到QQ音乐歌单 -->
                    <Button Click="OnContextMenuAddToQqPlaylistClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8F4;" FontSize="14" Width="18" Foreground="#10B981" />
                            <TextBlock Text="添加到QQ音乐歌单" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 收藏 / 取消收藏 -->
                    <Button Click="OnContextMenuToggleFavoriteClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="ContextMenuFavoriteIcon" Glyph="&#xEB51;" FontSize="14" Width="18" />
                            <TextBlock x:Name="ContextMenuFavoriteText" Text="收藏" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 不感兴趣 / 取消不感兴趣 -->
                    <Button Click="OnContextMenuToggleDislikeClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon x:Name="ContextMenuDislikeIcon" Glyph="&#xE8E0;" FontSize="14" Width="18" />
                            <TextBlock x:Name="ContextMenuDislikeText" Text="不感兴趣" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- 从歌单中删除 / 从本地列表移除 -->
                    <Border x:Name="ContextMenuRemoveDivider" Height="1" Margin="4,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" />
                    <Button x:Name="ContextMenuRemoveBtn" Click="OnContextMenuRemoveClick" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,7" CornerRadius="8" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" Width="18" Foreground="#EF4444" />
                            <TextBlock x:Name="ContextMenuRemoveText" Text="从歌单中删除" FontSize="13" Foreground="#EF4444" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="88" />
        </Grid.RowDefinitions>

        <!-- ==================== 1. Windows 11 原生云母标题栏 (AppTitleBar) ==================== -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="0,0,148,0"
            Background="Transparent"
            Loaded="OnAppTitleBarLoaded"
            SizeChanged="OnAppTitleBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 独立标题栏拖拽底层（交互控件通过 InputNonClientPointerSource.Passthrough 穿透） -->
            <Border
                x:Name="TitleBarDragRegion"
                Grid.ColumnSpan="3"
                Background="Transparent" />

            <!-- 左上角：品牌图标与标题 -->
            <StackPanel Grid.Column="0" Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False">
                <Border Width="26" Height="26" CornerRadius="6">
                    <Image x:Name="AppBrandLogoImg" Width="26" Height="26" Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    x:Name="BrandTitleText"
                    Text="Alger Music Player"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- 主内容区顶部栏：左侧按需显示原版圆形返回按钮 + 居中全局搜索框 -->
            <Grid Grid.Column="1">
                <Button
                    x:Name="TopBackButton"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="28,0,0,0"
                    Width="32"
                    Height="32"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="0"
                    CornerRadius="16"
                    Background="Transparent"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Click="OnTopBackButtonClick"
                    PointerEntered="OnTopBackButtonPointerEntered"
                    PointerExited="OnTopBackButtonPointerExited"
                    ToolTipService.ToolTip="返回上一页">
                    <FontIcon x:Name="TopBackButtonIcon" Glyph="&#xE72B;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <AutoSuggestBox
                    x:Name="TopSearchBox"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PlaceholderText="搜索单曲、歌手、专辑、歌单、MV、B站 BV号..."
                    QueryIcon="Find"
                    Loaded="OnTopSearchBoxLoaded"
                    SizeChanged="OnAppTitleBarSizeChanged"
                    TextChanged="OnSearchBoxTextChanged"
                    QuerySubmitted="OnSearchBoxQuerySubmitted" />
            </Grid>

            <!-- 右上角：Fluent 矢量图标快捷工具栏（与右侧原生最小化/最大化/关闭按钮 0..32px 垂直居中对齐） -->
            <StackPanel
                x:Name="TitleBarRightToolbar"
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Top"
                Height="32"
                Spacing="2"
                SizeChanged="OnAppTitleBarSizeChanged">
                <Button
                    Style="{StaticResource TransportIconButtonStyle}"
                    Height="30"
                    MinHeight="30"
                    Padding="8,0"
                    Click="OnStartIntelligenceModeClick"
                    ToolTipService.ToolTip="开启心动模式（智能推荐队列）">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB52;" FontSize="14" Foreground="#F43F5E" />
                        <TextBlock Text="心动" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    Style="{StaticResource TransportIconButtonStyle}"
                    Height="30"
                    MinHeight="30"
                    Padding="8,0"
                    Tag="Downloads"
                    Click="OnNavButtonClick"
                    ToolTipService.ToolTip="下载管理">
                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                </Button>
                <Button
                    x:Name="PinTopBtn"
                    Style="{StaticResource TransportIconButtonStyle}"
                    Height="30"
                    MinHeight="30"
                    Padding="8,0"
                    Click="OnTogglePinTopClick"
                    ToolTipService.ToolTip="窗口置顶">
                    <FontIcon x:Name="PinTopIcon" Glyph="&#xE718;" FontSize="14" />
                </Button>
                <Button
                    Style="{StaticResource TransportIconButtonStyle}"
                    Height="30"
                    MinHeight="30"
                    Padding="8,0"
                    Click="OnOpenMiniPlayerClick"
                    ToolTipService.ToolTip="切换迷你窗口模式">
                    <FontIcon Glyph="&#xE744;" FontSize="14" />
                </Button>
                <Button
                    Style="{StaticResource TransportIconButtonStyle}"
                    Height="30"
                    MinHeight="30"
                    Padding="8,0"
                    Click="OnToggleThemeClick"
                    ToolTipService.ToolTip="切换深色 / 浅色主题">
                    <FontIcon Glyph="&#xE793;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== 2. 主体区域：WinUI 3 原生 NavigationView + 多视图内容容器 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <NavigationView
                x:Name="MainNavView"
                Grid.Column="0"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                IsBackEnabled="False"
                IsSettingsVisible="False"
                OpenPaneLength="208"
                CompactPaneLength="48"
                PaneOpened="OnMainNavViewPaneStateChanged"
                PaneClosed="OnMainNavViewPaneStateChanged"
                BackRequested="OnNavViewBackRequested"
                ItemInvoked="OnMainNavViewItemInvoked">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="首页推荐" Tag="Home" IsSelected="True">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="综合搜索" Tag="Search">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE721;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="歌单广场" Tag="Playlists">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE93C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="新碟上架" Tag="Album">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE958;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="排行榜单" Tag="Toplist">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="电台播客" Tag="Podcast">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE95A;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="MV 视频" Tag="Mv">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="B站音源" Tag="Bilibili">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE714;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItemSeparator />
                    <NavigationViewItemHeader Content="我的音乐" />

                    <NavigationViewItem Content="收藏与历史" Tag="HistoryFavorite">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEB51;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="本地音乐" Tag="LocalMusic">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="下载管理" Tag="Downloads">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="个人中心" Tag="User">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="QQ音乐歌单" Tag="QqMusic">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8D6;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="系统设置" Tag="Settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <!-- 右侧内容工作区 -->
                <Grid Padding="28,18,24,12">
                    <ProgressBar
                        x:Name="GlobalLoadingBar"
                        IsIndeterminate="True"
                        VerticalAlignment="Top"
                        Visibility="Collapsed"
                        Foreground="{StaticResource BrandAccentBrush}" />

                    <!-- 顶部悬浮自动消失气泡提示 (对应 Naive UI n-message，自动淡入停留后淡出消失) -->
                    <Border
                        x:Name="FloatingToastBorder"
                        Canvas.ZIndex="99"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,4,0,0"
                        Padding="16,8"
                        CornerRadius="18"
                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                        BorderBrush="#5510B981"
                        BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="StatusBannerText"
                                MaxWidth="520"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- ==================== 视图 1：首页 (HomeView — Fluent v2 双大卡 + 四大推荐模块) ==================== -->
                    <ScrollViewer x:Name="HomeView" Visibility="Visible">
                        <StackPanel Spacing="26" Padding="0,0,10,28">
                            <!-- 顶部 HomeHero：左「每日推荐」大卡 + 右「私人 FM」大卡 -->
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 左卡：每日推荐 -->
                                <Border
                                    Grid.Column="0"
                                    Height="192"
                                    CornerRadius="12"
                                    Padding="20,16"
                                    RequestedTheme="Dark"
                                    BorderBrush="#3310B981"
                                    BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E6064E3B" Offset="0.0" />
                                            <GradientStop Color="#E60F172A" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="128" Height="128" CornerRadius="10" Background="#1F2937" VerticalAlignment="Center">
                                            <Grid>
                                                <Image x:Name="DailyHeroCoverImg" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#BF000000" CornerRadius="6" Padding="8,3">
                                                    <TextBlock x:Name="DailyHeroCountBadge" Text="30 首" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Column="1" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Spacing="2">
                                                <TextBlock Text="每日推荐" FontSize="20" FontWeight="Bold" Foreground="White" />
                                                <TextBlock Text="根据你的音乐口味生成 · 每日 6:00 更新" FontSize="12" Foreground="#A7F3D0" />
                                            </StackPanel>

                                            <ItemsControl x:Name="DailyPreviewItemsControl" Grid.Row="1" VerticalAlignment="Center">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SongItem">
                                                        <TextBlock FontSize="12" Foreground="#E5E7EB" Margin="0,2" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                            <Run Text=" - " Foreground="#9CA3AF" />
                                                            <Run Text="{x:Bind ArtistText}" Foreground="#9CA3AF" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                                <Button Click="OnPlayAllDailyClick" Style="{StaticResource BrandPrimaryButtonStyle}" CornerRadius="6" Padding="14,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                        <TextBlock Text="播放日推" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="查看列表" Click="OnOpenDailyDetailClick" CornerRadius="6" Padding="12,6" FontSize="12" Foreground="White" Background="#26FFFFFF" BorderThickness="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- 右卡：私人 FM -->
                                <Border
                                    Grid.Column="1"
                                    Height="192"
                                    CornerRadius="12"
                                    Padding="20,16"
                                    RequestedTheme="Dark"
                                    BorderBrush="#336366F1"
                                    BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E61E1B4B" Offset="0.0" />
                                            <GradientStop Color="#E60F172A" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="128" Height="128" CornerRadius="10" Background="#1F2937" VerticalAlignment="Center">
                                            <Image x:Name="FmHeroCoverImg" Stretch="UniformToFill" />
                                        </Border>

                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" HorizontalAlignment="Left" Background="#33818CF8" CornerRadius="6" Padding="8,3">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE95A;" FontSize="11" Foreground="#A5B4FC" />
                                                    <TextBlock Text="私人 FM · PERSONAL RADIO" FontSize="10" Foreground="#A5B4FC" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock x:Name="FmHeroSongTitle" Text="私人 FM 漫游" FontSize="19" FontWeight="Bold" Foreground="White" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="FmHeroArtistName" Text="点击下方播放键开启私人专属电台" FontSize="13" Foreground="#C7D2FE" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                                <Button Click="OnFmTrashClick" CornerRadius="6" Padding="10,6" Background="#26FFFFFF" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="不喜欢，移入垃圾桶并切下一首">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                                <Button x:Name="FmPlayBtn" Click="OnFmPlayPauseClick" Background="#6366F1" Foreground="White" BorderThickness="0" CornerRadius="6" Padding="14,6">
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4F46E5" />
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4338CA" />
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                                                    </Button.Resources>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                        <TextBlock Text="播放 FM" FontWeight="SemiBold" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="OnFmNextClick" CornerRadius="6" Padding="10,6" Background="#26FFFFFF" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="下一首 FM">
                                                    <FontIcon Glyph="&#xE893;" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 模块 1：推荐歌单 -->
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
