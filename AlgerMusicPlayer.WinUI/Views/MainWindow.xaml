                                                    </StackPanel>
                                                    <ToggleSwitch x:Name="GpuAccelerationToggle" Grid.Column="1" IsOn="True" MinWidth="0" OffContent="" OnContent="" Toggled="OnGpuAccelerationToggled" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ==================== Tab 2：播放设置 (1:1 还原 PlaybackTab.vue) ==================== -->
                                <StackPanel x:Name="SettingsPlaybackPanel" Visibility="Collapsed" HorizontalAlignment="Stretch" Spacing="20">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock Text="播放设置" Style="{StaticResource SettingsGroupHeaderTextStyle}" />

                                        <Border Style="{StaticResource SettingSectionCardStyle}">
                                            <StackPanel HorizontalAlignment="Stretch">
                                                <!-- 2.1 音质设置 -->
                                                <Border Style="{StaticResource SettingItemRowStyle}">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="音质设置" FontSize="15" FontWeight="Medium" />
                                                            <TextBlock Text="选择音乐播放音质（不确保有效）" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <ComboBox x:Name="QualityComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="OnQualitySelectionChanged">
                                                            <ComboBoxItem Content="标准" Tag="standard" />
                                                            <ComboBoxItem Content="较高" Tag="higher" />
                                                            <ComboBoxItem Content="极高" Tag="exhigh" />
                                                            <ComboBoxItem Content="无损" Tag="lossless" />
                                                            <ComboBoxItem Content="Hi-Res" Tag="hires" />
                                                            <ComboBoxItem Content="高清环绕声" Tag="jyeffect" />
                                                            <ComboBoxItem Content="沉浸环绕声" Tag="sky" />
                                                            <ComboBoxItem Content="杜比全景声" Tag="dolby" />
                                                            <ComboBoxItem Content="超清母带" Tag="jymaster" />
                                                        </ComboBox>
                                                    </Grid>
                                                </Border>

                                                <!-- 2.2 音源设置 (1:1 对齐 PlaybackTab.vue lines 15-37：第2项，开关与已选音源在左侧，右侧为"配置音源"按钮！) -->
                                                <Border Style="{StaticResource SettingItemRowStyle}">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                                                            <TextBlock Text="音源设置" FontSize="15" FontWeight="Medium" />
                                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                <ToggleSwitch x:Name="UnblockToggle" MinWidth="0" OffContent="" OnContent="" Toggled="OnUnblockToggled" />
                                                                <TextBlock x:Name="UnblockStateLabel" Text="开启" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="开启后将尝试解析无法播放的音乐" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <TextBlock x:Name="SelectedSourcesSummaryText" Text="已选音源：migu, kugou, kuwo, pyncmd" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Button x:Name="ConfigureMusicSourcesBtn" Grid.Column="1" Content="配置音源" Click="OnOpenMusicSourcesModalClick" CornerRadius="8" Padding="14,6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <!-- 2.3 自动播放 -->
                                                <Border Style="{StaticResource SettingItemRowStyle}">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="自动播放" FontSize="15" FontWeight="Medium" />
                                                            <TextBlock Text="重新打开应用时是否自动继续播放" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <ToggleSwitch x:Name="AutoPlayToggle" Grid.Column="1" MinWidth="0" OffContent="关闭" OnContent="开启" Toggled="OnAutoPlayToggled" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <!-- 2.4 音频输出设备 (1:1 对齐 AudioDeviceSettings.vue) -->
                                                <Border Style="{StaticResource SettingItemLastRowStyle}">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="音频输出设备" FontSize="15" FontWeight="Medium" />
                                                            <TextBlock Text="选择音频输出设备，如扬声器、耳机或蓝牙设备" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="8" Width="320" VerticalAlignment="Center">
                                                            <Grid>
                                                                <TextBlock Text="音频输出设备" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                                    <Button Click="OnRefreshAudioDevicesClick" Style="{StaticResource TransportIconButtonStyle}" ToolTipService.ToolTip="刷新输出设备">
                                                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                                    </Button>
                                                                    <Button Click="OnTestAudioDeviceClick" Padding="10,4" CornerRadius="6">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <FontIcon Glyph="&#xE767;" FontSize="12" />
                                                                            <TextBlock Text="测试" FontSize="12" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                            <ComboBox x:Name="AudioDeviceComboBox" HorizontalAlignment="Stretch" PlaceholderText="选择输出设备" SelectionChanged="OnAudioDeviceSelectionChanged" />
                                                            <TextBlock Text="Windows x64 本地/SMB 多声道播放使用 Windows 默认输出设备。" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 2.5 支持正版独立卡片 (1:1 对齐 PlaybackTab.vue lines 69-87：全部左对齐垂直排列！) -->
                                    <Border Style="{StaticResource SettingSectionCardStyle}" Padding="18,16">
                                        <StackPanel Spacing="10" HorizontalAlignment="Left">
                                            <TextBlock Text="支持正版" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="大家还是需要支持正版，本软件只做开源探讨。各大音乐会员购买链接：" FontSize="15" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <HyperlinkButton Content="网易云音乐会员 ↗" NavigateUri="https://music.163.com/store/vip" Foreground="{StaticResource BrandAccentBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="14,8" />
                                                <HyperlinkButton Content="QQ音乐会员 ↗" NavigateUri="https://y.qq.com/portal/vipportal/" Foreground="{StaticResource BrandAccentBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="14,8" />
                                                <HyperlinkButton Content="酷狗音乐会员 ↗" NavigateUri="https://vip.kugou.com/" Foreground="{StaticResource BrandAccentBrush}" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="10" Padding="14,8" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ==================== Tab 3：应用设置 (1:1 还原 ApplicationTab.vue) ==================== -->
                                <StackPanel x:Name="SettingsApplicationPanel" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                    <TextBlock Text="应用设置" Style="{StaticResource SettingsGroupHeaderTextStyle}" />

                                    <Border Style="{StaticResource SettingSectionCardStyle}">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <!-- 3.1 关闭行为 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="关闭行为" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="选择关闭窗口时的行为" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ComboBox x:Name="CloseActionComboBox" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="OnCloseActionChanged">
                                                        <ComboBoxItem Content="每次询问" Tag="ask" />
                                                        <ComboBoxItem Content="最小化到托盘" Tag="minimize" IsSelected="True" />
                                                        <ComboBoxItem Content="直接退出" Tag="close" />
                                                    </ComboBox>
                                                </Grid>
                                            </Border>

                                            <!-- 3.2 快捷键设置 (1:1 对齐 ApplicationTab.vue lines 14-19：点击"配置"弹出 ShortcutSettings.vue 模态框！) -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="快捷键设置" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="自定义全局快捷键" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="配置" Click="OnOpenShortcutModalClick" CornerRadius="8" Padding="14,6" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- 3.3 下载管理 (1:1 对齐 ApplicationTab.vue lines 21-32：开关在左侧描述区，右侧为"下载管理"跳转按钮！) -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                                                        <TextBlock Text="下载管理" FontSize="15" FontWeight="Medium" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <ToggleSwitch x:Name="AlwaysShowDownloadToggle" IsOn="True" MinWidth="0" OffContent="" OnContent="" Toggled="OnAlwaysShowDownloadToggled" />
                                                            <TextBlock x:Name="AlwaysShowDownloadStateLabel" Text="显示" FontSize="12" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="是否始终显示下载列表按钮" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="下载管理" Tag="Downloads" Click="OnNavButtonClick" CornerRadius="8" Padding="14,6" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- 3.4 无限制下载 (1:1 对齐 ApplicationTab.vue lines 34-42：开关在左侧描述区，右侧无控件！) -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                                                        <TextBlock Text="无限制下载" FontSize="15" FontWeight="Medium" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <ToggleSwitch x:Name="UnlimitedDownloadToggle" MinWidth="0" OffContent="" OnContent="" Toggled="OnUnlimitedDownloadToggled" />
                                                            <TextBlock x:Name="UnlimitedDownloadStateLabel" Text="关闭" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="开启后将无限制下载音乐（可能出现下载失败的情况）, 默认限制 300 首" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <ToggleSwitch x:Name="EmbedTagToggle" Visibility="Collapsed" IsOn="True" Toggled="OnEmbedTagToggled" />
                                                </Grid>
                                            </Border>

                                            <!-- 3.5 下载目录 (1:1 对齐 ApplicationTab.vue lines 44-56：左侧显示当前路径文本，右侧为"打开"与"修改"按钮！) -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="下载目录" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock x:Name="DownloadPathDisplayText" Text="选择音乐文件的下载位置" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                        <TextBox x:Name="DownloadPathBox" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Content="打开" Click="OnOpenDownloadFolderClick" CornerRadius="8" Padding="14,6" />
                                                        <Button Content="修改" Click="OnPickDownloadFolderClick" CornerRadius="8" Padding="14,6" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 3.6 远程控制 (1:1 对齐 ApplicationTab.vue lines 58-63：点击"配置"弹出 ServerSetting.vue 弹窗！) -->
                                            <Border Style="{StaticResource SettingItemLastRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="远程控制" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="设置远程控制功能" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="配置" Click="OnOpenRemoteControlModalClick" CornerRadius="8" Padding="14,6" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ==================== Tab 4：网络设置 (1:1 还原 NetworkTab.vue) ==================== -->
                                <StackPanel x:Name="SettingsNetworkPanel" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                    <TextBlock Text="网络设置" Style="{StaticResource SettingsGroupHeaderTextStyle}" />

                                    <Border Style="{StaticResource SettingSectionCardStyle}">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <!-- 4.1 音乐API端口 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="音乐API端口" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="修改后需要重启应用" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBox x:Name="MusicApiPortBox" Width="140" Text="30488" LostFocus="OnNetworkFieldLostFocus" />
                                                        <TextBox x:Name="CustomApiUrlBox" Visibility="Collapsed" Text="http://127.0.0.1:30488" />
                                                        <ToggleSwitch x:Name="UseCustomApiToggle" Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 4.2 代理设置 (1:1 对齐 NetworkTab.vue lines 17-30：右侧为开关 + "配置"按钮！) -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="代理设置" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="无法访问音乐时可以开启代理" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <ToggleSwitch x:Name="ProxyEnableToggle" MinWidth="0" OffContent="关闭" OnContent="开启" Toggled="OnProxyEnableToggled" />
                                                        <Button Content="配置" Click="OnOpenProxyModalClick" CornerRadius="8" Padding="14,6" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 4.3 realIP设置 (1:1 对齐 NetworkTab.vue lines 32-51：右侧为开关 + 开启时显示 realIP 输入框！) -->
                                            <Border Style="{StaticResource SettingItemLastRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="realIP设置" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="由于限制,此项目在国外使用会受到限制可使用realIP参数,传进国内IP解决" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                        <ToggleSwitch x:Name="EnableRealIpToggle" MinWidth="0" OffContent="关闭" OnContent="开启" Toggled="OnEnableRealIpToggled" />
                                                        <TextBox x:Name="RealIpBox" Width="200" PlaceholderText="realIP" Visibility="Collapsed" LostFocus="OnNetworkFieldLostFocus" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ==================== Tab 5：系统管理 (1:1 还原 SystemTab.vue 全部 8 行) ==================== -->
                                <StackPanel x:Name="SettingsSystemPanel" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                    <TextBlock Text="系统管理" Style="{StaticResource SettingsGroupHeaderTextStyle}" />

                                    <Border Style="{StaticResource SettingSectionCardStyle}">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <!-- 5.1 磁盘缓存 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="磁盘缓存" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="将播放过的音乐与歌词缓存到本地磁盘，提升二次播放速度" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ToggleSwitch x:Name="EnableDiskCacheToggle" Grid.Column="1" IsOn="True" MinWidth="0" OffContent="关闭" OnContent="开启" Toggled="OnDiskCacheConfigChanged" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- 5.2 缓存目录 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="缓存目录" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock x:Name="DiskCacheDirDisplayText" Text="自定义音乐与歌词缓存保存目录" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                                        <TextBox x:Name="DiskCacheDirBox" Visibility="Collapsed" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <Button Content="选择目录" Click="OnPickCacheFolderClick" CornerRadius="8" Padding="14,6" />
                                                        <Button Content="打开目录" Click="OnOpenAppDataFolderClick" CornerRadius="8" Padding="14,6" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 5.3 缓存上限 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="缓存上限" FontSize="15" FontWeight="Medium" />
                                                        <TextBlock Text="达到上限后将自动清理最旧缓存" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBox x:Name="DiskCacheMaxSizeBox" Width="130" Text="4096" LostFocus="OnDiskCacheConfigChanged" />
                                                        <TextBlock Text="MB" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 5.4 清理策略 -->
                                            <Border Style="{StaticResource SettingItemRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="清理策略" FontSize="15" FontWeight="Medium" />
