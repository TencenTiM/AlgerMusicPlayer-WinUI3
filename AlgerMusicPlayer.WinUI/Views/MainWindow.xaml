                                        <DataTemplate x:DataType="models:RadioStationItem">
                                            <Border Width="168" Margin="0,0,12,14" Padding="8" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
