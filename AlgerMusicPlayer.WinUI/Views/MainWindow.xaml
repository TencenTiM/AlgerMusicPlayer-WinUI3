                                                                <TextBlock Text="极快" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 1.7 GPU加速 (1:1 对齐 BasicTab.vue lines 168-185) -->
                                            <Border Style="{StaticResource SettingItemLastRowStyle}">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
