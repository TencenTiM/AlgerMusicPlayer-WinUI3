<Window
    x:Class="AlgerMusicPlayer.Installer.InstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AlgerMusicPlayer 安装向导"
    Width="640"
    Height="450"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize">

    <Window.Resources>
        <!-- 翡翠绿主按钮样式 -->
        <Style x:Key="PrimaryEmeraldButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="BtnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="22"
                            Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="18" ShadowDepth="0" Opacity="0.38" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#059669" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#047857" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级暗色按钮样式 -->
        <Style x:Key="SecondaryGlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="SecBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="#334155" />
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="#10B981" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶栏窗口控制按钮 -->
        <Style x:Key="CaptionIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层阴影与圆角磨砂琉璃主容器 -->
    <Border Margin="14" CornerRadius="18" BorderBrush="#2A10B981" BorderThickness="1.2">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1120" Offset="0" />
                <GradientStop Color="#111827" Offset="0.55" />
                <GradientStop Color="#0D1F1C" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <!-- 1. 自定义无边框标题栏（可拖拽） -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown" Margin="18,6,12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="WindowHeaderTitleText" Text="AlgerMusicPlayer 安装程序" Foreground="#CBD5E1" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionIconButtonStyle}" Click="OnMinimizeWindowClick" ToolTip="最小化">
                        <TextBlock Text="─" FontSize="11" />
                    </Button>
                    <Button x:Name="CloseWindowBtn" Style="{StaticResource CaptionIconButtonStyle}" Click="OnCloseWindowClick" ToolTip="关闭" Margin="4,0,0,0">
                        <TextBlock Text="✕" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. 主内容区（包含：安装配置页 / 安装进度页 / 安装完成页 / 卸载页） -->
            <Grid Grid.Row="1" Margin="32,8,32,8">

                <!-- 视图 A：安装配置页 -->
                <Grid x:Name="SetupConfigPage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 品牌 Hero 横幅 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,18">
                        <Border Width="82" Height="82" CornerRadius="20" Background="#1510B981" BorderBrush="#4010B981" BorderThickness="1">
                            <Image Source="pack://application:,,,/Assets/icon.png" Width="76" Height="76" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Alger Music Player" Foreground="White" FontSize="24" FontWeight="Bold" />
                                <Border Background="#2210B981" BorderBrush="#5510B981" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v5.1.0 · WinUI 3" Foreground="#34D399" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="原生 C# / WinUI 3 桌面音乐播放器 · 双平台歌单 · 10 段均衡器 · 桌面歌词" Foreground="#94A3B8" FontSize="12.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 一键快速安装大按钮 -->
                    <Button
                        x:Name="StartInstallBtn"
                        Grid.Row="1"
                        Width="240"
                        Height="44"
                        Content="立即安装"
                        Style="{StaticResource PrimaryEmeraldButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="OnStartInstallClick"
                        Margin="0,4,0,18" />

                    <!-- 安装路径选择卡片（支持中文路径） -->
                    <Border Grid.Row="2" Background="#161F30" BorderBrush="#293548" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="安装位置：" Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox
                                x:Name="InstallPathTextBox"
                                Grid.Column="1"
                                Background="#0F172A"
                                Foreground="#F1F5F9"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                Padding="8,5"
                                FontSize="12.5"
                                VerticalContentAlignment="Center" />
                            <Button
                                Grid.Column="2"
                                Content="更改目录..."
                                Style="{StaticResource SecondaryGlassButtonStyle}"
                                Padding="12,5"
                                Margin="10,0,0,0"
                                Click="OnBrowseInstallPathClick" />
                        </Grid>
                    </Border>

                    <!-- 附加选项复选框 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0">
                        <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,22,0" />
                        <CheckBox x:Name="StartMenuShortcutCheck" Content="添加到开始菜单" IsChecked="True" Foreground="#CBD5E1" FontSize="12.5" Margin="0,0,22,0" />
                        <CheckBox x:Name="AutoLaunchCheck" Content="安装完成后立即启动" IsChecked="True" Foreground="#CBD5E1" FontSize="12.5" />
                    </StackPanel>
                </Grid>

                <!-- 视图 B：正在安装/卸载实时进度页 -->
                <Grid x:Name="SetupProgressPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="480">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="64" Height="64" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,14" />
                        <TextBlock x:Name="ProgressTitleText" Text="正在安装 Alger Music Player..." Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ProgressPercentText" Text="0%" Foreground="#34D399" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,12" />

                        <!-- 自定义高颜值进度条 -->
                        <Border Height="10" Background="#1E293B" CornerRadius="5" ClipToBounds="True">
                            <Border x:Name="ProgressFillBar" HorizontalAlignment="Left" Width="0" Background="#10B981" CornerRadius="5" />
                        </Border>

                        <TextBlock
                            x:Name="ProgressDetailText"
                            Text="正在准备释放组件..."
                            Foreground="#94A3B8"
                            FontSize="12"
                            HorizontalAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 视图 C：安装完成页 -->
                <Grid x:Name="SetupCompletePage" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="72" Height="72" CornerRadius="36" Background="#2210B981" BorderBrush="#10B981" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="✓" Foreground="#34D399" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="CompleteTitleText" Text="Alger Music Player 安装成功！" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CompleteSubtitleText" Text="所有原生音频引擎与界面资源已部署完毕" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,24" />
                        <Button
                            x:Name="FinishActionBtn"
                            Width="220"
                            Height="44"
                            Content="立即体验"
                            Style="{StaticResource PrimaryEmeraldButtonStyle}"
                            HorizontalAlignment="Center"
                            Click="OnFinishButtonClick" />
                    </StackPanel>
                </Grid>

                <!-- 视图 D：卸载确认页（当以 Uninstall.exe 或卸载参数启动时显示） -->
                <Grid x:Name="UninstallConfirmPage" Visibility="Collapsed" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Width="460">
                        <Image Source="pack://application:,,,/Assets/icon.png" Width="64" Height="64" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,12" />
                        <TextBlock Text="卸载 Alger Music Player" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="确定要从当前电脑移除 Alger Music Player 吗？" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,18" />
                        <CheckBox
                            x:Name="RemoveUserDataCheck"
                            Content="同时清理个人配置文件、本地歌单缓存与历史记录"
                            IsChecked="False"
                            Foreground="#CBD5E1"
                            FontSize="12.5"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,22" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button
                                Width="150"
                                Height="40"
                                Content="确认卸载"
                                Style="{StaticResource PrimaryEmeraldButtonStyle}"
                                Click="OnConfirmUninstallClick"
                                Margin="0,0,14,0" />
                            <Button
                                Width="120"
                                Height="40"
                                Content="取消"
                                Style="{StaticResource SecondaryGlassButtonStyle}"
                                Click="OnCloseWindowClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 3. 底部状态信息栏 -->
            <Border Grid.Row="2" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid>
                    <TextBlock x:Name="FooterStatusText" Text="自包含免环境依赖安装包 · 支持中文路径安装与一键卸载" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBlock Text="AlgerMusicPlayer Native Installer" Foreground="#475569" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
