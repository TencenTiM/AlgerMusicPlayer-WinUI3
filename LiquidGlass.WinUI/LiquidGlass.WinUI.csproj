<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LiquidGlass.WinUI</RootNamespace>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="ComputeSharp.D2D1" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Upstream\Effects\Shaders\LiquidGlass.hlsl" />
    <EmbeddedResource Include="Upstream\Effects\Shaders\BlurH.hlsl" />
    <EmbeddedResource Include="Upstream\Effects\Shaders\BlurV.hlsl" />
    <EmbeddedResource Include="Upstream\Effects\Shaders\PostProcessing.hlsl" />
  </ItemGroup>
</Project>
